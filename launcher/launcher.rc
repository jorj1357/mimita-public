// launcher.rc — Resource script for MimitaLauncher
// Embeds the launcher icon, loading screen image, GUI config, and version info
// into the EXE. Resource IDs must be numeric: windres treats a bare token as a
// STRING name, which the loader then can't find via MAKEINTRESOURCE (this broke
// the background image before these #defines were added).
#define IDB_LOADING_IMAGE 101
#define GUI_CONFIG 102

// Application icon: Windows shows it for the launcher in the taskbar, Explorer
// and the system tray. Numeric ID 1 (coexists with the manifest, different type).
1 ICON "..\\assets\\uitextures\\mimita launcher icon.ico"

IDB_LOADING_IMAGE RCDATA "..\\assets\\uitextures\\mimita-loading-v1.png"
GUI_CONFIG RCDATA "..\\launcher\\launcher-gui.json"

// Version metadata — legitimate software carries it; malware does not. Keep the
// numeric fields in sync with LAUNCHER_VERSION in main.cpp. The resource NAME
// must be numeric 1: Windows looks up RT_VERSION by name 1 (VS_VERSION_INFO),
// and windres treats a bare token as a string name (same bug class as the image).
#define VER_FILEVERSION 1,0,2,0
#define VER_FILEVERSION_STR "1.0.2\0"
#define VER_PRODUCTVERSION 1,0,2,0
#define VER_PRODUCTVERSION_STR "1.0.2\0"
1 VERSIONINFO
 FILEVERSION VER_FILEVERSION
 PRODUCTVERSION VER_PRODUCTVERSION
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "MiMITA\0"
            VALUE "FileDescription", "MiMITA Launcher - installer, updater and hub\0"
            VALUE "FileVersion", VER_FILEVERSION_STR
            VALUE "InternalName", "MimitaLauncher\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 MiMITA\0"
            VALUE "OriginalFilename", "MimitaLauncher.exe\0"
            VALUE "ProductName", "MiMITA\0"
            VALUE "ProductVersion", VER_PRODUCTVERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// Common-Controls v6 manifest so TaskDialogIndirect resolves against comctl32
// v6 (the v5.82 System32 copy does not export it). Resource type must be the
// numeric RT_MANIFEST (24) — windres treats the bare token as a string name,
// which the loader ignores.
1 24 "launcher.manifest"
