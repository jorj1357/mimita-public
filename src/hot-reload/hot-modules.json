{
  "version": 1,
  "comment": "Hot replaceable module manifest. Sources compile into the coarse mimita-game DLL; headers participate in change detection and code hashing. 'cold' lists EXE-owned sources whose changes cannot be activated live (HOT_RELOAD_BOUNDARY_VIOLATION).",
  "modules": [
    {
      "name": "effects",
      "abi": 1,
      "sources": [
        "src/effects/effect-part.cpp"
      ]
    },
    {
      "name": "actor",
      "abi": 1,
      "sources": [
        "src/hot-reload/modules/actor-behavior.cpp"
      ]
    },
    {
      "name": "presentation",
      "abi": 1,
      "sources": [
        "src/hot-reload/modules/presentation.cpp"
      ]
    },
    {
      "name": "gameplay",
      "abi": 1,
      "sources": [
        "src/hot-reload/modules/rocket-behavior.cpp"
      ]
    },
    {
      "name": "editor",
      "abi": 1,
      "sources": [
        "src/hot-reload/modules/editor-behavior.cpp"
      ]
    }
  ],
  "headers": [
    "src/hot-reload/game-api.h",
    "src/hot-reload/game-modules.h",
    "src/hot-reload/hot-package.h",
    "src/hot-reload/hot-animation.h",
    "src/hot-reload/hot-pose.h",
    "src/hot-reload/hot-prediction.h",
    "src/hot-reload/hot-presentation.h",
    "src/hot-reload/hot-projectile.h",
    "src/hot-reload/hot-ui.h",
    "src/network/match-lifecycle.h",
    "src/network/objective-events.h",
    "src/network/relevance.h"
  ],
  "globs": [
    "src/hot-reload/modules/*.cpp",
    "src/hot-reload/modules/gamemodes/*.cpp",
    "src/hot-reload/modules/tools/*.cpp",
    "src/hot-reload/modules/presentation/*.cpp",
    "src/hot-reload/modules/ui/*.cpp"
  ],
  "cold": [
    "src/hot-reload/hot-reload-system.cpp",
    "src/hot-reload/generic-runtime.cpp",
    "src/hot-reload/generic-runtime.h",
    "src/live-code/live-behavior.cpp",
    "src/live-code/live-behavior.h",
    "src/live-code/live-editor.cpp",
    "src/live-code/live-editor.h",
    "src/live-code/live-gameplay.cpp",
    "src/live-code/live-gameplay.h",
    "src/network/server-damage-policy.cpp",
    "src/network/server-damage-policy.h",
    "src/network/server-damage.cpp",
    "src/network/server-attack.cpp",
    "src/network/server-melee.cpp",
    "src/network/server-physical-contact.cpp",
    "src/combat/weapon-rocket-launcher.cpp",
    "src/combat/weapon-system.cpp",
    "src/npc/npc.cpp",
    "src/network/server-projectiles.cpp",
    "src/network/server-npcs.cpp",
    "src/network/server-players.cpp",
    "src/network/multiplayer-projectiles.cpp",
    "src/ecs/entity-registry.cpp",
    "src/ecs/actor-entities.cpp",
    "src/sim/simulate-tick.cpp",
    "src/ragdoll/ragdoll-body.cpp",
    "src/network/multiplayer-reconcile.cpp",
    "src/network/multiplayer-packets.cpp",
    "src/network/multiplayer-tick.cpp",
    "src/network/server-packets.cpp",
    "src/npc/npc-combat.cpp",
    "src/engine/engine-tick-render.cpp",
    "src/combat/death-system.cpp",
    "src/hot-reload/generic-runtime.cpp",
    "src/project/capabilities.cpp"
  ]
}
