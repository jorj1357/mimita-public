// caps movement per frame? not sure, pla w it so its not restrictive
static void recover(Player& p,
                    const PhysicsSimpleConfig& cfg,
                    const World& world)
{
    const float MAX_PUSH = 0.05f;

    AABB pa = makePlayerAABB(p, cfg);

    for (const Block& b : world.blocks) {
        AABB ba = makeBlockAABB(b);
        if (!overlaps(pa, ba)) continue;

        glm::vec3 push;
        resolveOne(pa, ba, p.pos, 0.001f, push);

        push = glm::clamp(push,
                          glm::vec3(-MAX_PUSH),
                          glm::vec3( MAX_PUSH));

        p.pos += push;
        break;
    }
}

void physicsSimpleUpdate(
    Player& p,
    const World& world,
    const PhysicsSimpleConfig& cfg,
    const glm::vec2& wishMoveXY,
    bool jumpHeld,
    float dt
){
    dt = std::min(dt, 0.033f);
    bool groundedThisFrame = false;

    // 1. integrate gravity
    p.vel.z += cfg.gravity * dt;
    p.vel.z = std::max(p.vel.z, -cfg.maxFallSpeed);

    // 2. compute delta
    glm::vec3 delta;
    delta.x = wishMoveXY.x * dt;
    delta.y = wishMoveXY.y * dt;
    delta.z = p.vel.z * dt;

    // 2.1. put this before step 3, so movement works
    auto moveAxis = [&](int axis, float delta) {
        if (delta == 0.0f) return;

        glm::vec3 tryPos = p.pos;
        tryPos[axis] += delta;

        AABB pa = makePlayerAABBAt(tryPos, cfg);

        for (const Block& b : world.blocks) {
            // dont just continue, 
            // if we continue when its a slope, we walk thru walls. not good
            // if (b.isSlope) continue;
            if (overlaps(pa, makeBlockAABB(b)))
                return; // blocked
        }

        p.pos[axis] = tryPos[axis];
    };

    // 3. horizontal movement (X/Y)
    moveAxis(0, delta.x);
    moveAxis(1, delta.y);

    // 4. vertical movement (Z, solid blocks only)
    {
        glm::vec3 tryPos = p.pos;
        tryPos.z += delta.z;

        AABB pa = makePlayerAABBAt(tryPos, cfg);
        bool hit = false;

        for (const Block& b : world.blocks) {
            if (b.isSlope) continue;
            if (overlaps(pa, makeBlockAABB(b))) {
                hit = true;
                break;
            }
        }

        if (!hit) {
            p.pos.z = tryPos.z;
        } else if (p.vel.z < 0.0f) {
            groundedThisFrame = true;
            p.vel.z = 0.0f;
        }
    }

    // 5. slope penetration prevention (ONLY prevent going inside)
    // BOUNDED. DONT LET PLANES BE INFINITE, WITH THE local and fabs
    for (const Block& b : world.blocks) {
        if (!b.isSlope) continue;

        glm::vec3 foot = p.pos;
        foot.z -= cfg.playerHeight * 0.5f;

        // transform foot into slope local space
        glm::vec3 local = glm::inverse(b.rot) * (foot - b.pos);

        // float hx = b.size.x * 0.5f;
        // float hy = b.size.y * 0.5f;

        // DONT GET STUCK IN THE CETNER OF IT. THATS STUPID
        // SLOPE over lap fixes it probabl.
        float hx = b.size.x * 0.5f + SLOPE_OVERLAP;
        float hy = b.size.y * 0.5f + SLOPE_OVERLAP;

        // outside slope → ignore plane
        if (local.x < -hx || local.x > hx ||
            local.y < -hy || local.y > hy)
            continue;

        glm::vec3 n = glm::normalize(b.rot * glm::vec3(0,0,1));
        if (n.z < 0.5f) continue;

        glm::vec3 p0 = b.pos + n * (b.size.z * 0.5f);
        float d = glm::dot(foot - p0, n);

        if (d > 0.0f) {
            p.pos.z -= d;
            if (p.vel.z <= 0.0f)
                groundedThisFrame = true;
        }
    }

    // 6. finalize grounded state
    p.onGround = groundedThisFrame;

    // 7. jump
    static float coyoteTimer = 0.0f;

    if (p.onGround)
        coyoteTimer = COYOTE_JUMP_TIME;
    else
        coyoteTimer -= dt;

    if (jumpHeld && coyoteTimer > 0.0f) {
        p.vel.z = cfg.jumpStrength;
        coyoteTimer = 0.0f;
        p.onGround = false;
    }

    // 8. resolve penetration ONCE
    resolveStuck(p, cfg, world);

    // 9. drag (last)
    float drag = std::exp(-FRICTION_AMOUNT * dt);
    p.vel.x *= drag;
    p.vel.y *= drag;
}
