#pragma once
#include <glm/glm.hpp>

struct Player;
struct World;

struct PhysicsSimpleConfig {
    float gravity = -25.0f;
    float maxFallSpeed = 60.0f;
    float playerWidth  = 0.70f;
    float playerDepth  = 0.70f;
    float playerHeight = 2.80f;
    float slop = 0.0005f;
    bool autoHop = false;
    float jumpStrength = 12.0f;
};

void physicsSimpleUpdate(
    Player& p,
    const World& world,
    const PhysicsSimpleConfig& cfg,
    const glm::vec2& wishMoveXY,
    bool jumpHeld,
    bool dashPressed,
    bool freezeHeld,
    bool groundReturnPressed,
    const glm::vec3& camForward,
    float dt
);