/**
 * purpose
 * take json file
 * turnn it into stuff we walk on
 */

#include "world/world-loader.h"
#include "world/world.h"
// #include "map/texture_manager.h"

#include <fstream>
#include <cstdio>

// use whatever JSON lib you already use elsewhere
#include <nlohmann/json.hpp>

using json = nlohmann::json;

bool loadWorldFromJSON(World& world, const char* path)
{
    printf("BEGIN LOADWORLDFROMJSON world loader cpp: abt to world clear\n");
    world.clear();

        printf("world loader cpp: abt to std ifstream f path failde to open idk\n");
    printf("PATH = '%s'\n", path);
    for (int i = 0; path[i]; i++)
        printf("%d ", (unsigned char)path[i]);
    printf("\n");

    std::ifstream f(path, std::ios::binary);
    if (!f.is_open()) {
        printf("[WORLD] Failed to open %s\n", path);
        return false;
    }
        printf("world loader cpp: abt to string raw istreambufiterator idk\n");

    std::string raw(
        (std::istreambuf_iterator<char>(f)),
        std::istreambuf_iterator<char>()
    );
        printf("world loader cpp: abt to replace the nan if infinitnities etc idk\n");

    // Replace invalid floats (nan / inf from Blender)
    auto fix = [](std::string& s) {
        const char* bad[] = { "nan", "NaN", "inf", "Infinity", "-inf", "-Infinity" };
        for (auto b : bad) {
            size_t p;
            while ((p = s.find(b)) != std::string::npos)
                s.replace(p, strlen(b), "0");
        }
    };
            printf("world loader cpp: fixing raw\n");

    fix(raw);
            printf("world loader cpp: json j abotu thapen\n");

    json j;
            printf("world loader cpp: try catch j = json parse raw \n");

    try {
        j = json::parse(raw);
    }
    catch (const std::exception& e) {
        printf("[WORLD] JSON parse error: %s\n", e.what());
        return false;
    }

    if (!j.contains("blocks") || !j["blocks"].is_array()) {
        printf("[WORLD] JSON missing blocks array\n");
        return false;
    }

    printf("[WORLD] blocks = %zu\n", j["blocks"].size());
  printf("world loader cpp:for auto jb blocks we do block stuff now  \n");
    for (auto& jb : j["blocks"]) {
        Block b{};

        b.pos = glm::vec3(
            jb["position"][0].get<float>(),
            jb["position"][1].get<float>(),
            jb["position"][2].get<float>()
        );

        b.size = glm::vec3(
            jb["size"][0].get<float>(),
            jb["size"][1].get<float>(),
            jb["size"][2].get<float>()
        );

        b.rotEuler = glm::vec3(
            jb["rotation"][0].get<float>(),
            jb["rotation"][1].get<float>(),
            jb["rotation"][2].get<float>()
        );

        for (int i = 0; i < 6; i++)
            b.tex[i] = 0;

        world.blocks.push_back(b);
    }
  printf("world loader cpp: world finalize and rebuld \n");
    world.finalize();
      printf("world loader cpp: world rebuild actual \n");

    world.rebuildChunks();

    printf("[WORLD] world built OK\n");
    return true;
}
