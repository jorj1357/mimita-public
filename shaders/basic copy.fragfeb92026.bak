// can u put comments in a .frag bc thats awesome if u can jan 30 2025 
// u can have comments omg ok cool jan 30 2025

#version 330 core
out vec4 FragColor;

in float vDepth;
in vec3 vWorldPos;

uniform vec3 uColor;   // <---- add this
uniform int  uUseColor; // 0 = world, 1 = override (debug)

float hash(vec3 p) {
    return fract(sin(dot(p, vec3(12.9898,78.233,45.164))) * 43758.5453);
}

void main() {
    float h = hash(floor(vWorldPos));

    // default
    //     float shade = clamp(1.0 - vDepth*0.02, 0.3, 1.0);
        
    // bright bc i like it 
    // * 0.005 = 4x as bright, lower = higher contrast?
    // clamp 0.8 = almost flat lighting idk what mean    
    float shade = clamp(1.0 - vDepth*0.005, 0.3, 1.0);

    vec3 worldBase = vec3(0.2, 0.4, 0.8);   // BLUE WORLD
    worldBase += h * 0.15;                  // slight variation

    vec3 finalColor = (uUseColor == 1)
        ? uColor
        : worldBase;

    // fake color by texId
    // float t = float(vTexId) / 255.0;
    // FragColor = vec4(t, 1.0 - t, 0.5, 1.0);

    // og working but commented out feb 9 2026
    FragColor = vec4(finalColor * shade, 1.0);
}
