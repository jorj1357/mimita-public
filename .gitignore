# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
website/node_modules/

# ── Build output ──────────────────────────────────────────────────────────────
build/
bin/
out/
dist/

# ── Compiled binaries (must be built, not committed) ─────────────────────────
*.exe
*.dll
*.lib
*.ilk
*.pdb
*.o
*.gch
*.pch
*.d
*.so
*.a

# ── Asset pack ───────────────────────────────────────────────────────────────
*.pak
.pak-extracted

# ── Audio assets (game loads these from disk; don't touch or commit) ─────────
*.wav
*.mp3
*.ogg
*.flac
*.aiff

# ── Video ────────────────────────────────────────────────────────────────────
*.mp4
*.webm
*.avi
*.mov

# ── Raw image sources (not game textures) ────────────────────────────────────
*.kra
*.psd
*.xcf
*.blend
*.blend1
*.png~
*.autosave

# ── Config / env ─────────────────────────────────────────────────────────────
.env
.env.local

# ── Generated article data ───────────────────────────────────────────────────
website/public/articles.generated.json

# ── Temp / cache ─────────────────────────────────────────────────────────────
tmp/
temp/
build/cache/
__pycache__/

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
*.err
*.out

# ── Replays ──────────────────────────────────────────────────────────────────
replays/
exports/

# ── OS junk ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── Editor ───────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
*.bak

# ── Aider ────────────────────────────────────────────────────────────────────
.aider*
