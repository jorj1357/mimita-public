# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
website/node_modules/

# ── Build output ──────────────────────────────────────────────────────────────
build/
bin/
out/
dist/

# ── Compiled binaries ────────────────────────────────────────────────────────
*.exe
*.dll
*.lib
*.ilk
*.pdb
*.o
*.obj
*.gch
*.pch
*.d
*.so
*.a
*.exp

# ── Asset pack ───────────────────────────────────────────────────────────────
*.pak
.pak-extracted

# ── Audio: music/production files NEVER tracked ──────────────────────────────
# Gameplay SFX under entity/, ui/, weapon/ ARE tracked (explicitly un-ignored).
*.wav
*.mp3
*.ogg
*.flac
*.aiff
!assets/sound/entity/**/*.wav
!assets/sound/entity/**/*.mp3
!assets/sound/ui/**/*.wav
!assets/sound/ui/**/*.mp3
!assets/sound/weapon/**/*.wav
!assets/sound/weapon/**/*.mp3
assets/sound/music/

# ── Video ────────────────────────────────────────────────────────────────────
*.mp4
*.webm
*.avi
*.mov

# ── Raw image sources ────────────────────────────────────────────────────────
*.kra
*.kra~
*.psd
*.xcf
*.blend
*.blend1
*.png~
*.autosave

# ── Config / env ─────────────────────────────────────────────────────────────
.env
.env.local

# ── Generated data ───────────────────────────────────────────────────────────
website/public/articles.generated.json

# ── Temp / cache ─────────────────────────────────────────────────────────────
tmp/
temp/
build/cache/
__pycache__/

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
*.err
*.out

# ── Replays ──────────────────────────────────────────────────────────────────
replays/
exports/

# ── OS junk ──────────────────────────────────────────────────────────────────
