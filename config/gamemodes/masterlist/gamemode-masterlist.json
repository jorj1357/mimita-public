{
  "schema_version": 1,
  "readme": [
    "This file is the single contributor guide and validation contract for config/gamemodes/*.json.",
    "Every mode file must contain every setting below, in the same order. The runtime rejects a mode that is missing any field.",
    "required=true is retained for documentation, but complete mode files are required as a whole: the loader and offline checker reject missing fields.",
    "null means inherit the shared config/playervisuals.json value (used by presentation layers and trails).",
    "Optional policy blocks (payload, npc_targeting, npc_travel, avatar, npc_avatar) contain enabled:false when the mode does not use them; the loader then ignores the block and preserves its previous behavior.",
    "Nested object schemas use fields. Arrays use item. Objects whose keys are arbitrary use additional.",
    "enum lists the only accepted string values. min/max are inclusive numeric limits.",
    "avatar_groups are named allow/deny policies. A mode may set avatar.group or npc_avatar.group to reuse them.",
    "Run: python devscripts/gamemode_json_sync.py --check  (reports missing/unknown/out-of-order fields)",
    "Run: python devscripts/gamemode_json_sync.py --write  (explicit canonical migration)"
  ],
  "settings": {
    "id": {
      "type": "string",
      "required": true,
      "description": "Stable mode id. Must match the JSON filename stem."
    },
    "name": {
      "type": "string",
      "required": true,
      "default": "Duel",
      "description": "Display name in menus and HUD."
    },
    "description": {
      "type": "string",
      "required": false,
      "default": "",
      "description": "Short mode description for menu presentation."
    },
    "team_names": {
      "type": "array",
      "required": false,
      "default": [
        "RED",
        "BLUE"
      ],
      "item": {
        "type": "string"
      },
      "description": "Legacy team display names. Ordered teams inside teams override this."
    },
    "goal_value": {
      "type": "integer",
      "required": false,
      "default": 20,
      "min": 0,
      "description": "Score/kill goal for score modes. 0 means no score goal."
    },
    "weapon_set_id": {
      "type": "integer",
      "required": false,
      "default": 1,
      "min": 1,
      "description": "Legacy numeric weapon set id."
    },
    "time_limit_seconds": {
      "type": "integer",
      "required": false,
      "default": 0,
      "min": 0,
      "description": "Match time limit. 0 means mode-defined/no limit."
    },
    "time_limit_outcome": {
      "type": "string",
      "required": false,
      "default": "high_score",
      "enum": [
        "high_score",
        "stalemate"
      ],
      "description": "Result when the time limit expires before the score goal."
    },
    "respawn_seconds": {
      "type": "number",
      "required": false,
      "default": 0.0,
      "min": 0.0,
      "description": "Delay before an actor respawns."
    },
    "kill_heals": {
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Whether a kill restores health."
    },
    "friendly_fire": {
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Whether teammates may damage one another."
    },
    "countdown_seconds": {
      "type": "number",
      "required": false,
      "default": 3.0,
      "min": 0.0,
      "description": "Pre-match countdown length."
    },
    "go_seconds": {
      "type": "number",
      "required": false,
      "default": 1.0,
      "min": 0.0,
      "description": "GO phase length."
    },
    "rematch_seconds": {
      "type": "number",
      "required": false,
      "default": 5.0,
      "min": 0.0,
      "description": "Rematch prompt/length."
    },
    "spawn_tracer_seconds": {
      "type": "number",
      "required": false,
      "default": 1.5,
      "min": 0.0,
      "description": "Spawn tracer visibility duration."
    },
    "allow_rematch": {
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Whether a rematch is offered."
    },
    "spawn_offset_radius": {
      "type": "number",
      "required": false,
      "default": 5.0,
      "min": 0.0,
      "description": "Random spawn offset radius in meters."
    },
    "spawn_strategy": {
      "type": "string",
      "required": false,
      "default": "shared",
      "enum": [
        "shared",
        "team_shared",
        "distributed",
        "random"
