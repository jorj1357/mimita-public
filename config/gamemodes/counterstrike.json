{
  "id": "counterstrike",
  "name": "Counter Strike",
  "description": "5v5 round-based bomb defusal on dust2cyberiav4.",
  "respawn_seconds": 0,
  "teams": [
    {
      "id": "ct",
      "display_name": "Counter-Terrorists",
      "capacity": 5,
      "role": "counter_terrorist",
      "spawn_group": "ct_spawn"
    },
    {
      "id": "t",
      "display_name": "Terrorists",
      "capacity": 5,
      "role": "terrorist",
      "spawn_group": "t_spawn"
    },
    {
      "id": "spec",
      "display_name": "Spectator",
      "capacity": 0,
      "role": "spectator"
    }
  ],
  "rounds": {
    "max_rounds": 15,
    "rounds_to_win": 8,
    "round_seconds": 115,
    "freeze_seconds": 5,
    "countdown_seconds": 3,
    // "intermission_seconds": 30,
    "intermission_seconds": 1,
    "results_seconds": 5
  },
  "spawn_groups": {
    "ct_spawn": { "team": "ct", "points": [] },
    "t_spawn": { "team": "t", "points": [] }
  },
  "objectives": [
    {
      "id": "bomb",
      "kind": "bomb",
      "carrier_team": "t",
      "site_group": "bomb_sites",
      "plant_seconds": 3,
      "defuse_seconds": 5,
      "explosion_seconds": 40,
      "visual": {
        "pulse": true,
        "radius": 0.35,
        "pulse_amplitude": 0.15,
        "period_seconds": 1.5,
        "color": [1.0, 0.25, 0.1, 0.8]
      }
    }
  ],
  "victory": { "type": "rounds" },
  "actor_preset": "counter_strike",
  // NPC-only combat profile for this mode. Overrides each role's behavior
  // profile (explicit > gamemode > role > default). Humans are never affected.
  "npc_behavior_profile": "rage2",
  // Team-based enemy targeting. Does not depend on npc-difficulty.json.
  // "opposite_team" = any live actor on a hostile team; same-team is never
  // selected, and no hostile actor means patrol/forward movement.
  "npc_targeting": {
    "mode": "opposite_team",
    "include_players": true,
    "include_npcs": true
  },
  // Per-team/mode NPC travel weighting. objective_bias scales moving to the
  // bomb/site objective; hunt_bias scales travelling toward the team's
  // best-known enemy area when no objective dominates. Values are multipliers
  // (1.0 neutral, 0 disables). Hot-reloadable.
  "npc_travel": {
    "objective_bias": 1.0,
    "hunt_bias": 0.6,
    "explore_bias": 0.4
  },
  // Mode-level RMB aim-FOV override. Independent of the physical right-arm
  // aim-body mode; the input condition is simply "right mouse held".
  "camera": {
    "aim_fov": {
      "enabled": true,
      "input": "right_mouse",
      "multiplier": 0.5,
      "duration": 0.5,
      "easing": "ease_in_out"
    }
  },
  "hide_healthbars": true,
  "ragdoll_enabled": true,
  "blood_enabled": true,
  "presentation": {
    "damage_numbers": false,
    "hit_effects": false,
    "world_impact_effects": false,
    "hit_markers": false,
    "hit_sounds": false,
    "killfeed": true,
    "player_outlines": false
  },
  "maps": ["dust2cyberiav4"]
}
