{
  "version": 1,
  "comment": "Live networking tuning (single source of truth). Edit while running -> hot-reloads every client + hosted/dedicated server within ~250ms. Snapshots: 'networkconfig list' / 'networkconfig load <N>' / 'networkconfig save'. Per-exe overrides: 'badconn <N>' and 'netinterp delay <ms>'.",
  "hot_reload": {
    "enabled": true,
    "poll_interval_ms": 250,
    "log_changes": true
  },

  "remote_player_interpolation": {
    "enabled": true,
    "direct_render": false,
    "server_smoothing": true,
    "server_smoothing_duration_ticks": 2,
    "server_broadcast_delay_ms": 1,
    "server_broadcast_extrapolation_ms": 1000,
    "rewind_compensation_ms": 1,
    "rewind_hit_tolerance": 2.5,
    "server_broadcast_max_speed": 0,
    "server_sim_smooth_ticks": 2,
    "interpolation_delay_ms": 1,
    "maximum_buffered_snapshots": 64,
    "minimum_snapshots_before_rendering": 2,
    "position_mode": "linear",
    "rotation_mode": "slerp",
    "allow_extrapolation": true,
    "maximum_extrapolation_ms": 1000,
    "teleport_distance": 1000.0,
    "teleport_gap_ticks": 30,
    "broadcast_source": "server_sim",
    "extrapolation_keep_moving": true,
    "teleport_gap_snap": true,
    "snap_on_spawn": true,
    "snap_on_respawn": true,
    "snap_on_map_change": true
  },

  "local_player_reconciliation": {
    "enabled": true,
    "correction_mode": "hard",
    "correction_duration_ms": 100,
    "hard_snap_distance": 100.0
  },

  "snapshot_buffer": {
    "use_server_tick": true,
    "discard_duplicate_snapshots": true,
    "allow_out_of_order_insertion": true,
    "maximum_snapshot_age_ms": 2000,
    "chunk_reassembly_timeout_ms": 1000
  },

  "adaptive_snapshot_buffer": {
    "enabled": true,
    "minimum_delay_ms": 8,
    "maximum_delay_ms": 60,
    "jitter_multiplier": 2.0,
    "arrival_jitter_smoothing": 0.15,
    "increase_rate_ms_per_second": 200,
    "decrease_rate_ms_per_second": 150,
    "loss_gap_ticks": 2,
    "loss_delay_budget_ms": 80,
    "loss_smoothing": 0.1
  },

  "snapshot_redundancy": {
    "enabled": true
  },

  "remote_motion_smoothing": {
    "comment": "Post-interpolation motion filter on rendered remote bodies. render_filter: direct (no smoothing) | bounded (converge discontinuities over a few frames; normal motion passes through) | spring (always-on critically-damped, literally cannot snap, slight follow-lag) | hybrid (velocity-feed-forward spring: spring's zero-snap PLUS crisp tracking of fast/up-down motion with ~zero lag) | linear (CS-style delayed interpolation: render linear_delay_ticks packets behind the newest and always slide linearly between the two bracketing snapshots; never renders the newest directly; the delay is a loss buffer that hides up to linear_delay_ticks lost packets).",
    "render_filter": "linear",
    "correction_max_step_units_per_second": 100.0,
    "correction_min_delta_units": 0.05,
    "spring_stiffness": 300.0,
    "spring_damping": 50.0,
    "spring_frequency_hz": 0.0,
    "spring_damping_ratio": 0.0,
    "spring_feed_forward": 1.0,
    "spring_feed_forward_smoothing": 1.0,
    "spring_frequency_z_multiplier": 10.0,
    "spring_max_speed_units_per_second": 0.0,
    "spring_linear_deadzone_units": 0.01,
    "hybrid_frequency_hz": 1.0,
    "hybrid_damping_ratio": 1.0,
    "hybrid_feed_forward": 1.0,
    "hybrid_frequency_z_multiplier": 15.0,
    "hybrid_feed_forward_smoothing": 1.0,
    "hybrid_max_speed_units_per_second": 0.0,
    "filter_max_step_units_per_second": 0.0,
    "filter_clamp_z_below_target": true,
    "linear_delay_ticks comment": "8 7 2026 keep this low? i would like to only have it be min/max delay that handles the delay but idk how it works well enough ",
    "linear_delay_ticks": 2,
    "linear_min_delay_ticks": 2,
    "linear_max_delay_ticks": 8,
    "linear_hold_on_dry": false,
    "linear_allow_extrapolation": true,
    "linear_catchup_rate_ticks_per_second": 0.0,
    "linear_delay_jitter_multiplier": 1.0,
    "linear_delay_loss_weight": 1.0,
    "linear_snap_after_gap_ticks": 999,
    "linear_clock_source": "wall_time",
    "linear_reanchor_enabled_comment": "i disable this 8 7 2026 bc it seems less snappy/jittery when its off? but it seems like, its a hack fix, and we should have constraints like must be linear, must have this snapping on, etc, so we force it to perform well while having ideal long term settings, no hack fixes",
    "linear_reanchor_enabled": true,
    "linear_reanchor_only_if_error_ms": 20,
    "linear_deadzone_units": 0.005,
    "max_render_time_jump_ms": 1
  },

  "death_effects": {
    "comment": "Red sphere of death spawned from the snapshot health transition so every client (attacker, victim, observers) sees a death even under packet loss.",
    "remote_player_death_effect": true,
    "local_player_death_effect": true
  },

  "confirmed_hit_feedback": {
    "comment": "The client already shows an instant predicted hitmarker/number/sound on its local trace. These gate whether the server's confirmed DamageConfirmedEvent replays them (default prediction-only = one crisp hit feedback).",
    "show_hitmarker": false,
    "show_damage_number": false,
    "show_hit_sound": false
  },

  "disagreement_visuals": {
    "comment": "Server-disagree effects (correction indicators, HIT REJECTED pops). Keep off when prediction is trusted; disagreements should be rare and shrinking.",
    "enabled": true
  },

  "prediction": {
    "comment": "Client-side prediction scope. Hitmarker + hit sound are ALWAYS predicted (instant). predict_damage controls instant damage numbers + target health bar; predict_deaths controls instant death + kill heal (rolls back with a disagree effect if the server disagrees).",
    "predict_damage": true,
    "predict_deaths": false
  },

  "event_timeline": {
    "enabled": true,
    "remote_effect_maximum_hold_ms": 500,
    "log_delays": false
  },

  "runtime_rates": {
    "input_send_rate_hz": 60,
    "ping_interval_ms": 1000
  },

  "retries": {
    "attack_retry_interval_ms": 50,
    "attack_retry_max_attempts": 10,
    "attack_request_timeout_ms": 3000,
    "reconnect_initial_backoff_ms": 1000,
    "reconnect_max_attempts": 10,
    "reconnect_max_backoff_ms": 15000
  },

  "reliable_gameplay_events": {
    "max_pending_per_player": 64,
    "retry_ms": 50,
    "ttl_ms": 10000,
    "max_attempts": 80
  },

  "buffer_limits": {
    "server_position_history_ticks": 30,
    "server_broadcast_sample_limit": 128
  },

  "remote_entity_lifecycle": {
    "comment": "A remote entity is only removed after being absent from this many complete, newer membership snapshots for at least this many ms. Brief packet gaps, jitter, reorder, and blackouts cannot destroy players.",
    "missing_snapshot_confirmation_count": 3,
    "missing_snapshot_grace_ms": 1000,
    "require_newer_complete_snapshots": true
  },

  "network_timeouts": {
    "client_timeout_ms": 10000,
    "server_timeout_ms": 10000,
    "connect_timeout_ms": 6000
  },

  "debug": {
    "show_remote_snapshot_positions": false,
    "show_interpolated_position": false,
    "show_buffer_size": false,
    "log_snapshot_arrival": false,
    "log_interpolation_state": false,
    "interpolation_log_rate_hz": 10,
    "detect_interpolation_jitter": true,
    "max_allowed_alpha_jump": 0.35,
    "max_allowed_visual_delta_multiplier": 2.5
  },

  "badconn": {
    "comment": "Per-client bad-connection profiles. 'badconn 1' affects THIS exe only; each mimita.exe has its own simulator. latency.base_ms + jitter_ms = realistic correlated ping; loss burst_percent/burst_probability = bad-wifi loss bursts.",
    "presets": {
      "1": {
        "name": "Antipodal bad internet",
        "latency": { "direction": "both", "base_ms": 200, "jitter_ms": 50 },
        "loss": { "direction": "both", "min_percent": 2, "max_percent": 6, "burst_percent": 30, "burst_probability": 0.15 },
        "reorder": { "direction": "both", "min_percent": 2, "max_percent": 3, "window": 8 },
        "blackout": { "enabled": true, "start_probability_per_second": 0.005, "min_ms": 800, "max_ms": 2000, "cooldown_ms": 60000, "direction": "both", "release_queued": false }
      },
      "2": {
        "name": "High latency (steady)",
        "latency": { "direction": "both", "base_ms": 250, "jitter_ms": 0 }
      },
      "3": {
        "name": "Packet loss",
        "loss": { "direction": "both", "min_percent": 10, "max_percent": 15, "burst_percent": 50, "burst_probability": 0.2 }
      },
      "4": {
        "name": "Reordering",
        "reorder": { "direction": "both", "min_percent": 8, "max_percent": 10, "window": 8 }
      },
      "5": {
        "name": "Severe combined",
        "latency": { "direction": "both", "base_ms": 250, "jitter_ms": 60 },
        "loss": { "direction": "both", "min_percent": 10, "max_percent": 15, "burst_percent": 40, "burst_probability": 0.2 },
        "reorder": { "direction": "both", "min_percent": 8, "max_percent": 10, "window": 8 }
      },
      "6": {
        "name": "5 second blackout",
        "blackout": {
          "enabled": true,
          "start_probability_per_second": 0.02,
          "min_ms": 5000,
          "max_ms": 5000,
          "cooldown_ms": 15000,
          "direction": "both",
          "release_queued": false
        }
      },
      "7": {
        "name": "15 second blackout",
        "blackout": {
          "enabled": true,
          "start_probability_per_second": 0.01,
          "min_ms": 15000,
          "max_ms": 15000,
          "cooldown_ms": 20000,
          "direction": "both",
          "release_queued": false
        }
      }
    }
  }
}
