{
  "version": 1,
  // 2026 10 28 0948 root mode 1 = limbs use authored translation
  // mode 2 = 2026-11-26 soft tether; see rootTranslationLimits below
  "rootTranslationMode": 1,
  // "rootTranslationMode": 2,
  // Mode 2 (2026-11-26) is a soft limb tether, not a hard zero. Rotations
  // still animate; each part's local translation is saturated smoothly at its
  // budget so a limb cannot drift far from its socket. These are metres.
  "rootTranslationLimits": {
    "torso": 0.005,
    "head": 0.005,
    "leftArm": 0.01,
    "rightArm": 0.01,
    "leftLeg": 0.01,
    "rightLeg": 0.01
  },
  "renderPoseInterpolation": true,
  "deathPresentation": "auto",
  "hurtTierMode": 1,
  "hurtPercent": {
    "smallMax": 15,
    "normalMax": 30
  },
  "hurtFixed": {
    "smallMax": 10,
    "normalMax": 50
  },
  "statePriorities": {
    "idle": 0,
    "land": 5,
    "walk": 10,
    "run": 10,
    "jump": 20,
    "fall": 20,
    "crouch": 30,
    "crouchWalk": 30,
    "hurt": 60,
    "dash": 70,
    "downDash": 72,
    "freeze": 74,
    "attack": 80,
    "death": 100
  }
}
