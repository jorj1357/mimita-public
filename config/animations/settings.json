{
  "version": 1,
  // 2026 10 28 0948 root mode 1 = limbs use authored translation
  // mode 2 = 2026-11-26 soft tether; see rootTranslationLimits below
  // "rootTranslationMode": 1,
  "rootTranslationMode": 2,
  // Mode 2 keeps rotations and saturates each part's local translation at its
  // socket budget. All six parts share the 0.01 m cap unless overridden.
  "rootTranslationLimits": {
    "torso": 0.01,
    "head": 0.01,
    "leftArm": 0.01,
    "rightArm": 0.01,
    "leftLeg": 0.01,
    "rightLeg": 0.01
  },
  // 1 = frame-dt animation advance, 2 = advance by elapsed server ticks.
  // Mode 2 keeps remote/NPC clips moving at the 60 Hz tick rate regardless of FPS.
  "animationAdvanceMode": 2,
  // Crouch presentation/capsule policy. Height scale is relative to standing;
  // leg sockets lift toward mid-torso by this many metres when crouched.
  "crouchHeightScale": 0.5,
  "crouchLegSocketLiftM": 0.35,
  "crouchSocketBlendSeconds": 0.12,
  "renderPoseInterpolation": true,
  "deathPresentation": "auto",
  "hurtTierMode": 1,
  "hurtPercent": {
    "smallMax": 15,
    "normalMax": 30
  },
  "hurtFixed": {
    "smallMax": 10,
    "normalMax": 50
  },
  "statePriorities": {
    "idle": 0,
    "land": 5,
    "walk": 10,
    "run": 10,
    "jump": 20,
    "fall": 20,
    "crouch": 30,
    "crouchWalk": 30,
    "hurt": 60,
    "dash": 70,
    "downDash": 72,
    "freeze": 74,
    "attack": 80,
    "death": 100
  }
}
