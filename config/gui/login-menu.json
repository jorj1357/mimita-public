{
  "format": "mimita-gui-layout",
  "version": 3,
  "elements": {
    "loginBg": {
      "type": "panel",
      "layer": 0,
      "x": 0, "y": 0, "width": 1920, "height": 1080,
      "backgroundColor": [0.035, 0.04, 0.052, 1.0]
    },
    "loginTitle": {
      "type": "text",
      "layer": 1,
      "x": 810, "y": 100, "width": 300, "height": 50,
      "text": "Sign In If u want Or something hehehhhhhehehehehe",
      "fontSize": 0.65,
      "textColor": [0.95, 0.98, 1.0, 1.0]
    },
    "identifierLabel": {
      "type": "text",
      "layer": 1,
      "x": 720, "y": 200, "width": 480, "height": 24,
      "text": "Username or Email",
      "fontSize": 0.32,
      "textColor": [0.8, 0.86, 0.95, 1.0]
    },
    "identifierInput": {
      "type": "text_input",
      "layer": 1,
      "x": 720, "y": 228, "width": 480, "height": 44,
      "binding": "auth.form.identifier",
      "fontSize": 0.34,
      "textColor": [1, 1, 1, 1],
      "backgroundColor": [0.15, 0.18, 0.24, 1.0],
      "focusedBackgroundColor": [0.2, 0.25, 0.32, 1.0],
      "placeholder": "username or email@example.com",
      "placeholderColor": [0.4, 0.45, 0.55, 0.7]
    },
    "passwordLabel": {
      "type": "text",
      "layer": 1,
      "x": 720, "y": 284, "width": 480, "height": 24,
      "text": "Password",
      "fontSize": 0.32,
      "textColor": [0.8, 0.86, 0.95, 1.0]
    },
    "passwordInput": {
      "type": "password_input",
      "layer": 1,
      "x": 720, "y": 312, "width": 480, "height": 44,
      "binding": "auth.form.password",
      "fontSize": 0.34,
      "textColor": [1, 1, 1, 1],
      "backgroundColor": [0.15, 0.18, 0.24, 1.0],
      "focusedBackgroundColor": [0.2, 0.25, 0.32, 1.0],
      "placeholder": "Enter your password",
      "placeholderColor": [0.4, 0.45, 0.55, 0.7]
    },
    "rememberMeCheckbox": {
      "type": "checkbox",
      "layer": 1,
      "x": 720, "y": 374, "width": 20, "height": 20,
      "binding": "auth.form.remember_me",
      "text": "Remember Me",
      "fontSize": 0.28,
      "textColor": [0.75, 0.8, 0.9, 1.0],
      "checkboxColor": [0.2, 0.5, 0.85, 1.0]
    },
    "signInButton": {
      "type": "button",
      "layer": 1,
      "x": 810, "y": 424, "width": 300, "height": 54,
      "text": "Sign In",
      "fontSize": 0.38,
      "textColor": [1, 1, 1, 1],
      "backgroundColor": [0.2, 0.55, 0.9, 1.0],
      "hoverBackgroundColor": [0.25, 0.6, 0.95, 1.0]
    },
    "cancelButton": {
      "type": "button",
      "layer": 1,
      "x": 40, "y": 40, "width": 120, "height": 50,
      "text": "Back",
      "fontSize": 0.38,
      "textColor": [1, 1, 1, 1],
      "backgroundColor": [0.55, 0.2, 0.2, 1.0]
    },
    "statusText": {
      "type": "text",
      "layer": 1,
      "x": 720, "y": 504, "width": 480, "height": 30,
      "binding": "auth.runtime.status_text",
      "fontSize": 0.32,
      "textColor": [0.5, 0.85, 0.5, 1.0]
    },
    "errorText": {
      "type": "text",
      "layer": 1,
      "x": 720, "y": 504, "width": 480, "height": 30,
      "binding": "auth.runtime.error_message",
      "fontSize": 0.32,
      "textColor": [1.0, 0.3, 0.3, 1.0]
    },
    "forgotPasswordButton": {
      "type": "button",
      "layer": 1,
      "x": 810, "y": 552, "width": 300, "height": 40,
      "text": "Forgot Password?",
      "fontSize": 0.28,
      "textColor": [0.55, 0.6, 0.7, 1.0],
      "backgroundColor": [0.0, 0.0, 0.0, 0.0],
      "hoverBackgroundColor": [0.15, 0.18, 0.24, 0.6]
    },
    "signUpButton": {
      "type": "button",
      "layer": 1,
      "x": 810, "y": 604, "width": 300, "height": 50,
      "text": "Sign Up",
      "fontSize": 0.36,
      "textColor": [1, 1, 1, 1],
      "backgroundColor": [0.2, 0.45, 0.25, 1.0],
      "hoverBackgroundColor": [0.25, 0.55, 0.3, 1.0]
    }
  }
}
