{
  "format": "mimita-gui-layout",
  "version": 3,
  "elements": {
    "intermissionText": {
      "type": "text",
      "text": "INTERMISSION {seconds}",
      "x": 960, "y": 400,
      "fontSize": 0.6,
      "textColor": [1.0, 1.0, 1.0, 0.9]
    },
    "modeTitle": {
      "type": "text",
      "text": "{mode_name}",
      "x": 960, "y": 18,
      "fontSize": 0.42,
      "textColor": [1.0, 1.0, 1.0, 1.0]
    },
    "scoreText": {
      "type": "text",
      "text": "{red_name} {red_score} / {goal}    {blue_name} {blue_score} / {goal}",
      "x": 960, "y": 45,
      "fontSize": 0.38,
      "textColor": [1.0, 1.0, 1.0, 1.0]
    },
    "matchTime": {
      "type": "text",
      "text": "TIME LEFT {minutes}:{seconds}",
      "x": 960, "y": 72,
      "fontSize": 0.34,
      "textColor": [1.0, 1.0, 1.0, 1.0]
    },
    "leaderboardText": {
      "type": "text",
      "fontSize": 0.30,
      "textColor": [1.0, 1.0, 1.0, 1.0]
    },
    "ffaLeader1": { "type": "text", "text": "{rank}. {name}: {score}K", "x": 20, "y": 20, "fontSize": 0.36, "textColor": [1.0, 0.85, 0.0, 1.0] },
    "ffaLeader2": { "type": "text", "text": "{rank}. {name}: {score}K", "x": 220, "y": 20, "fontSize": 0.36, "textColor": [0.75, 0.75, 0.8, 1.0] },
    "ffaLeader3": { "type": "text", "text": "{rank}. {name}: {score}K", "x": 420, "y": 20, "fontSize": 0.36, "textColor": [0.8, 0.5, 0.2, 1.0] },
    "redScore": { "type": "text", "text": "RED: {red_score}K", "x": 20, "y": 20, "fontSize": 0.36, "textColor": [1.0, 0.3, 0.3, 1.0] },
    "blueScore": { "type": "text", "text": "BLUE: {blue_score}K", "x": 1740, "y": 20, "fontSize": 0.36, "textColor": [0.3, 0.5, 1.0, 1.0] },
    "scoreGain": { "type": "text", "x": 960, "y": 45, "fontSize": 0.36, "textColor": [0.0, 1.0, 0.0, 1.0], "risePixels": 18, "lifetimeTicks": 30 },
    "countdownText": {
      "type": "text",
      "text": "{countdown}",
      "goText": "GO!!!",
      "x": 960, "y": 100,
      "fontSize": 2.5,
      "textColor": [1.0, 1.0, 1.0, 1.0]
    },
    "recordingIndicator": {
      "type": "text",
      "x": 1800, "y": 20,
      "fontSize": 0.28,
      "textColor": [0.2, 1.0, 0.3, 0.9]
    }
  }
}
