{
  "format": "mimita-gui-layout",
  "version": 3,
  "elements": {
    "overlay": {
      "type": "panel",
      "x": 0, "y": 0, "width": 1920, "height": 1080,
      "backgroundColor": [0, 0, 0, 0.6]
    },
    "panel": {
      "type": "panel",
      "x": 660, "y": 300, "width": 600, "height": 340,
      "backgroundColor": [0.025, 0.03, 0.04, 0.98],
      "outlineColor": [0.8, 0.3, 0.3, 0.85]
    },
    "title": {
      "type": "text",
      "x": 660, "y": 320, "width": 600, "height": 48,
      "text": "PRIVATE SERVER",
      "textAlign": "center",
      "fontSize": 0.60,
      "textColor": [1, 1, 1, 1]
    },
    "serverName": {
      "type": "text",
      "x": 700, "y": 375, "width": 520, "height": 30,
      "text": "",
      "textAlign": "center",
      "fontSize": 0.32,
      "textColor": [0.65, 0.7, 0.8, 1]
    },
    "passwordLabel": {
      "type": "text",
      "x": 700, "y": 420, "width": 520, "height": 28,
      "text": "Enter the password to join:",
      "textAlign": "left",
      "fontSize": 0.28,
      "textColor": [0.75, 0.8, 0.9, 1]
    },
    "passwordInput": {
      "type": "password_input",
      "x": 700, "y": 455, "width": 520, "height": 44,
      "binding": "popup.password",
      "fontSize": 0.34,
      "textColor": [1, 1, 1, 1],
      "backgroundColor": [0.12, 0.14, 0.2, 1],
      "submitOnEnter": true
    },
    "errorText": {
      "type": "text",
      "x": 700, "y": 505, "width": 520, "height": 24,
      "text": "",
      "textAlign": "center",
      "fontSize": 0.26,
      "textColor": [1, 0.35, 0.3, 1]
    },
    "okButton": {
      "type": "button",
      "x": 720, "y": 550, "width": 240, "height": 52,
      "text": "JOIN",
      "textAlign": "center",
      "verticalAlign": "middle",
      "fontSize": 0.42,
      "backgroundColor": [0.1, 0.35, 0.15, 1],
      "hoverColor": [0.16, 0.55, 0.22, 1]
    },
    "cancelButton": {
      "type": "button",
      "x": 960, "y": 550, "width": 240, "height": 52,
      "text": "CANCEL",
      "textAlign": "center",
      "verticalAlign": "middle",
      "fontSize": 0.42,
      "backgroundColor": [0.35, 0.08, 0.08, 1],
      "hoverColor": [0.55, 0.12, 0.12, 1]
    }
  }
}
