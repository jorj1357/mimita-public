{
  // Weapon collision hitboxes. `source: "boxes"` makes each box a triangle mesh
  // (each face 2 triangles) that collides through the SAME actor-vs-world
  // triangle path as a player's body, so it uses the real collision solver
  // instead of the legacy sphere/capsule approximation. Edit the boxes to tune a
  // weapon: center/half_size are weapon-local, scale is per-axis, and
  // rotation_degrees is Euler. Hot-reloaded every 250ms. Set "visible": true to
  // show the configured collider.
  // A single box approximating each weapon is used below; add more boxes[] for
  // compound hitboxes. True .glb triangle loading is deferred for now.
  //
  // bounce_mode controls how a weapon reacts when it touches the world:
  //   "inherit_actor" (DEFAULT): acts like an extra limb and uses normal
  //       actor/limb bounce. player_bounce is ignored.
  //   "custom": uses player_bounce as a multiplier on collision.json strength.
  //   "none": blocks/project velocity without adding weapon bounce.
  // player_bounce only matters when bounce_mode is "custom".
  // "collision_skin" is the per-weapon query/recovery margin.

  "revolver": {
    "enabled": true,
    // "visible": true,
    "visible": false,
    "collision_skin": 0.05,
    "bounce_mode": "inherit_actor",
    "player_bounce": 0.99,
    // "player_bounce": 0.3,
    // "player_bounce": 0.01,
    // "player_bounce": 0.0,
    "source": "boxes",
    "boxes": [
      { "enabled": true, "name": "body", "center": [0.15, 0.0, 0.0],
        "half_size": [1.02, 0.22, 0.22], "scale": [1,1,1], "rotation_degrees": [0,0,0] }
    ]
  },

  "shotgun": {
    "enabled": true,
