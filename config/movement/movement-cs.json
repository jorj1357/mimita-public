// 08 15 2026, 16 12
/* purpose
* Defines the Counter-Strike-style Source movement preset.
* Uses view-relative wish velocity and projection-limited Source AirAccelerate.
* Keeps all Source constants hot-reloadable through movement_reload.
* Does NOT use MiMITA air steering, camera-turn gates, or matching-strafe rules.
* Does NOT implement movement formulas or change the default selected preset.
* Does NOT add air friction or direct lateral air walking.
*/
{
    "name": "counterstrike",
    "comment": "Counter-Strike-style movement. Ground uses Source friction and acceleration. Air uses only Source AirAccelerate projection with the 30/320 air wish-speed ratio scaled to MiMITA units.",
    "movement_mode": "source",

    "ground_speed": 20.0,
    "max_speed": 20.0,
    "ground_acceleration": 5.5,
    "friction": 5.2,
    "stop_speed": 3.75,
    "surface_friction": 1.0,
    "normalize_diagonal_input": true,

    "bunny_hop": true,
    "auto_bhop_enabled": true,
    "air_strafing": true,
    "air_acceleration": 12.0,
    "air_max_wishspeed": 1.875,
    "source_airaccelerate_bug_compatible": true,
    "air_speed_gain_multiplier": 1.0,

    "gravity": -58.0,
    "jump_strength": 19.0,
    "max_fall_speed": 400.0,
    "jump_buffer_time": 0.12,
    "coyote_time": 0.001,
    "max_air_jumps": 0,

    "air_friction": 0.0,
    "external_impulse_decay": 0.6,
    "max_external_impulse_speed": 120.0,

    "ground_dash_impulse": 100.0,
    "air_dash_impulse": 50.0,
    "down_dash_speed": -100.0,

    "debug_draw_enabled": false,

    "tuning_notes": {
        "comment": "air_max_wishspeed 1.875 is Source's 30/320 cap scaled to max_speed 20. source_airaccelerate_bug_compatible=true uses uncapped wishspeed only in the acceleration term, matching Valve's historical implementation."
    }
}
