// 08 15 2026, 16 12
/* purpose
* Defines the default MiMITA movement preset and its hot-reloadable tuning.
* Preserves the legacy instant horizontal control used by existing gameplay.
* Keeps Source-only tuning inert unless movement_mode explicitly selects source.
* Does NOT implement movement formulas, poll input, or select itself globally.
* Does NOT modify collision, networking, rendering, or player persistence.
* Does NOT opt players into Source movement.
*/
// Merged from the active profile and the dated reference copy.
// Values already in the active profile are kept; Source-value comments are retained as reference notes.
// 2026 10 17 1522 jorj todo make this into the smash brothers melee movement set
// so like wasd = the move direction, instnat accel and kinda low friciton
// binds are gona be different and stuff todo figure that out 
// like left ctrl= down or crouch, q = sheild, e = grab, etc 
// and space held down here = more jump, like mario. held for 1 tick = minimum jump, 10 ticks = max jump 

// 08 27 2026
/* purpose
* Counter-Strike 1.6 / GoldSrc movement preset,
* but tuned to use MiMITA's faster current Source preset values.
*
* Ground:
*   Source / GoldSrc PM_Friction + PM_Accelerate behavior.
*
* Air:
*   GoldSrc / Source PM_AirAccelerate:
*   - projection-limited air acceleration
*   - historical Valve behavior where uncapped wishspeed can be used in the
*     acceleration term while capped wishspd is used for projection.
*
* IMPORTANT:
* This is no longer a numerically strict CS 1.6 preset.
* The movement equations remain Source/GoldSrc-family behavior, but the actual
* tuning values below match MiMITA's faster "source" preset.
*
* This file is parsed with JSON comments enabled.
*/
{
    "name": "default",
    "comment": "Current MiMITA behavior. WASD overrides horizontal velocity instantly. Source-only tuning below remains inert in mimita mode.",

    // Uses MiMITA's Source/GoldSrc-style movement kernel.
    // Melee: instant WASD steering, but external knockback is composable motion
    // and is never folded into or cleared by movement input.
    "movement_mode": "smash",

    // Scale/reference value.
    // 1 MiMITA unit = 20 Source / GoldSrc units.
    //
    // Rates such as acceleration and friction are NOT divided by this.
    // Distances and velocities are.
    "source_units_per_mimita_unit": 20.0,

    // ── Ground speed and acceleration ─────────────────────────────────────

    // MiMITA normal ground speed.
    //
    // FAST SOURCE PRESET VALUE:
    // 20 MiMITA units/sec.
    "max_speed": 20.0,

    // Keep server-side ground movement validation at the same speed.
    "ground_speed": 20.0,

    // Extremely high ground acceleration from the fast Source preset.
    //
    // This makes WASD feel nearly instant instead of gradually accelerating
    // like strict CS 1.6 sv_accelerate 5.
    "ground_acceleration": 1.0,

    // Ground friction from the fast Source preset.
    //
    // Higher values remove ground velocity more aggressively when movement
    // input is released.
    "friction": 5.25,

    // Very small stop-speed threshold from the fast preset.
    //
    // This avoids the stronger low-speed braking behavior of a traditional
    // GoldSrc stopspeed value and keeps movement responsive.
    "stop_speed": 1.0,

    // ── Air — Source / GoldSrc PM_AirAccelerate ───────────────────────────

    // Scales how much speed can be gained from air strafing.
    //
    // 0 = no air speed gain.
    // 1 = normal implementation gain.
    // 2 = current MiMITA fast preset.
    "air_speed_gain_multiplier": 1.0,

    //  the experimental MiMITA directional/input blend.
    //  9 5 2026 its not working super good its supposed t
    // o let u press a movement key in the air with no mouse 
    // = u move in that direction like default behavior but in the air
    //
    // false = use pure Source-style PM_AirAccelerate behavior.
    "air_input_blending_enabled": false,

    // Unused while air_input_blending_enabled is false.
    //
    // Kept here so the config remains compatible with the extended MiMITA
    // movement configuration format.
    "air_input_blending": 1.0,

    // Unused while air input blending is disabled.
    //
    // A deliberately huge value is retained from the previous cs16 config so
    // enabling blending accidentally does not immediately make tiny mouse
    // movements count as full Source strafing.
    "air_input_mouse_threshold_degrees": 0.0,

    // Air acceleration strength.
    //
    // Matches the fast Source preset.
    "air_acceleration": 22.0,

    // Projection cap for Source-style air acceleration.
    //
    // This does NOT cap total horizontal air velocity to 1.1.
    // It limits the portion of velocity projected onto the current wish
    // direction, allowing repeated correctly-angled strafes to continue
    // building total speed.
    //
    // Matches the fast Source preset.
    "air_max_wishspeed": 0.0,

    // Historical Valve-style AirAccelerate behavior.
    //
    // The capped wishspd is used for projection/addspeed while the uncapped
    // wishspeed can be used in the acceleration calculation.
    //
    // Keep true for the movement behavior used by the fast Source preset.
    "source_airaccelerate_bug_compatible": true,

    // ── Gravity and jump ──────────────────────────────────────────────────

    // Downward acceleration.
    //
    // Matches the fast Source preset.
    "gravity": -68.0,

    // Upward velocity applied when jumping.
    //
    // Matches the fast Source preset.
    "jump_velocity": 18.0,
    // "jump_velocity": 10.0,

    // Add the jump impulse to the current vertical velocity. This preserves
    // upward/downward momentum instead of replacing it with jump_velocity.
    // To restore the old behavior, change this to: "jump_mode": "replace"
    // "jump_mode": "additive",
    "jump_mode": "replace",

    // Maximum downward falling speed.
    //
    // Matches the fast Source preset.
    "max_fall_speed": 400.0,

    // ── Jump behavior ─────────────────────────────────────────────────────

    // Hold jump to automatically jump again immediately on landing.
    //
    // This is a MiMITA convenience extension rather than strict vanilla CS
    // input behavior.
    // "auto_bhop_enabled": true,
    "auto_bhop_enabled": false,

    // Remember jump input for this long before landing.
    //
    // Matches the fast Source preset.
    // "jump_buffer_time": 0.1,
    "jump_buffer_time": 0.12,
    // "jump_buffer_time": 0.01,

    // No coyote-time forgiveness.
    //
    // 0 keeps ledge behavior closer to old Source/GoldSrc movement.
    "coyote_time": 0.001,

    // MiMITA's current fast preset allows one extra air jump.
    //
    // This is NOT vanilla CS 1.6 behavior, but is intentionally kept here so
    // this preset now matches the fast MiMITA Source preset.
    "max_air_jumps": 1,

    // ── Melee jump input policy ───────────────────────────────────────────
    // 2026 10 17: Smash-style Space. Jump starts immediately at the minimum
    // strength and gains upward boost for up to 10 held server ticks, stopping
    // on release. This is a mode/profile input policy, not a buffer or cooldown.
    "jump_input_mode": "hold_scaled",
    "hold_jump_min_multiplier": 1.0,
    // Provisional Melee value: 1 tick = minimum, 10 held ticks = 1.5x.
    // The previous 22.6x produced roughly 400 m/s vertical launch.
    "hold_jump_max_multiplier": 1.5,
    "hold_jump_charge_ticks": 10,

    // ── Ground snap ───────────────────────────────────────────────────────

    // Remove tiny downward numerical velocity while grounded to prevent
    // visible ground jitter.
    "ground_snap": true,

    // Numerical cleanup threshold used by ground snap.
    //
    // Matches the fast Source preset.
    "velocity_clip_epsilon": 1.01,

    // Melee grounded-pose grace. The collision floor bounce can briefly report
    // no contact while the body is still resting; keep the stable grounded state
    // long enough that crouch/idle does not flash into fall.
    "stable_ground_grace_seconds": 0.15,

    // Melee held-down fast fall (Left Ctrl while airborne).
    "fast_fall_enabled": true,
    "fast_fall_acceleration": 120.0,
    "fast_fall_max_speed": 90.0,

    // Normal surface friction multiplier.
    "surface_friction": 1.0,

    // Amount of overspeed friction applied around landing behavior.
    //
    // 1.0 = full configured landing bleed.
    // 0.0 = preserve overspeed completely through landing.
    //
    // Matches the fast Source preset.
    "landing_overspeed_bleed": 0.0,

    // ── MiMITA dash extensions ────────────────────────────────────────────
    //
    // Melee-safe profile (supersmashbrosmelee.md §12 and §15):
    //   - Freeze and the legacy down-dash are NOT part of Melee and are
    //     disabled here. Left Ctrl is crouch/airborne-down, not down-dash.
    //   - Shift dash is kept: quick direction changes / dash dancing are a
    //     deliberate movement tool in the mode (dash binding is still OPEN in
    //     §13 and revisited after playtesting).

    // Shift ground/air dash.
    "dash_enabled": true,

    // Q down-dash / slam — disabled for Melee (§12, §15).
    "down_dash_enabled": false,

    // MiMITA freeze ability — disabled for Melee (§12, §15).
    "freeze_enabled": false,

    // Time after a dash during which its boost is protected from ordinary
    // ground friction.
    //
    // Matches the fast Source preset.
    "dash_grace_seconds": 1.0,

    // Ground-friction multiplier during dash grace.
    //
    // 0.0 = dash receives no ground friction during the grace period.
    "dash_friction_multiplier": 0.0,

    // Horizontal velocity impulse from a grounded dash.
    //
    // Matches the fast Source preset.
    "ground_dash_impulse": 25.0,
    // "ground_dash_impulse": 50.0,

    // Horizontal velocity impulse from an airborne dash.
    //
    // Matches the fast Source preset.
    "air_dash_impulse": 25.0,
    // "air_dash_impulse": 50.0,

    // Vertical velocity assigned by down-dash.
    //
    // Negative = downward.
    "down_dash_speed": -100.0,
    // "down_dash_speed": -250.0,

    // ── External impulse / knockback ─────────────────────────────────────
    //
    // These values match the fast Source preset.
    //
    // NOTE:
    // MiMITA's current movement implementation may fold knockback into the
    // player's real velocity as a single-tick impulse before this older
    // external-velocity behavior becomes relevant.

    // Exponential decay rate for the legacy separate external impulse path.
    //
    // In a true "source" impulse mode this may be ignored, but the fast preset
    // currently uses exponential mode.
    // "external_impulse_decay": 0.6,
    // "external_impulse_decay": 5.0,
    "external_impulse_decay": 2.0,
    // "external_impulse_decay": 0.5,

    // Maximum allowed horizontal external impulse speed.
    //
    // 9999 is intentionally effectively unlimited for normal gameplay.
    "max_external_impulse_speed": 9999.0,
    "external_impulse_resistance_multiplier": 1.0,
    // "external_impulse_resistance_multiplier": 99.0,

    // Match the current fast Source preset's knockback behavior.
    //
    // "exponential" = external impulse uses the legacy decay behavior when
    // that code path is active.
    "impulse_friction_mode": "exponential",

    // Fresh knockback remains untouched for this duration before its normal
    // decay/friction behavior begins.
    //
    // Gives impacts a short, clearly visible pop.
    "impulse_carry_seconds": 0.1,

    // ── Misc ──────────────────────────────────────────────────────────────

    // Allow Source-style WASD air strafing.
    "air_strafing": true,

    // Movement debug visualization.
    "debug_draw_enabled": false,

    // ── Global speed limit ────────────────────────────────────────────────
    //
    // The original cs16 preset had a hard 50-unit horizontal speed ceiling.
    //
    // The fast Source preset DOES NOT contain that ceiling. Leaving a fixed
    // 50-unit cap enabled would make this preset slower even though every
    // acceleration/dash value above matched.
    //
    // Therefore the limit is disabled here so bhop, dash, knockback, and other
    // momentum can behave like the fast Source preset.
    //
    // The numeric values remain defined so this can be enabled live without
    // requiring another schema/config change.

    // "speed_limit_enabled": false,
    "speed_limit_enabled": false,

    // Only used if speed_limit_enabled is true.
    "speed_limit": 50.0,

    // "fixed" = acceleration/impulses are prevented from exceeding the limit.
    // "clamp" = final horizontal velocity is clamped after movement.
    //
    // Irrelevant while speed_limit_enabled is false.
    "speed_limit_mode": "fixed",

    // ── Additional MiMITA profile fields retained from the active file ──
    "preserve_straight_speed": true,
    "preserve_speed_when_not_strafing": true,
    "diagonal_input_normalization": true,
    "minimum_strafe_angle": 0.0,
    "maximum_acceleration_per_tick": 0.0,
    "maximum_speed_gain_per_tick": 0.0,
    "speed_cap_enabled": false,
    "maximum_bhop_speed": 0.0,
    "speed_cap": 0.0,
    "maximum_bhop_speed_mode": "none",
    "acceleration_falloff_near_cap": 0.0,
    "landing_speed_retention": 0.0,
    "require_active_wish_rotation": true,
    "stationary_camera_input_mode": "strict",
    "air_steering_response": 1.0,
    "maximum_steering_degrees_per_second": 0.0,
    "minimum_camera_yaw_delta_degrees": 1110.25,
    "minimum_wish_rotation_degrees": 0.25,
    "strafe_angular_tolerance_degrees": 60.0,
    "soft_cap_start": 0.0,
    "air_speed": 20.0,
    "ground_deceleration": 0.0,
    "ground_direction_change_response": 0.0,
    "air_speed_gain_acceleration": 22.0,
    "air_wish_speed": 0.0,
    "air_control": 0.0,
    "stopspeed": 1.0,
    "jump_strength": 18.0,
    "ground_friction": 1.0,
    "air_friction": 0.0,

    "tuning_notes": {
        "comment": "Merged movement profile. Existing active-file values are kept where fields overlap; missing Source-style fields and comments are carried over from the dated reference. movement_mode is mimita, so Source-only movement formulas remain inactive unless that mode is selected."
    }
}
