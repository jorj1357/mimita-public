{
  "id": "arcade_arena",
  "description": "Rocket-League-style arcade controls on the shared vehicle system. Data only; no arena-specific solver.",
  "transmission": {
    "automatic": true,
    "engine_auto_start": true
  },
  "boost": {
    "max": 100.0,
    "fullDrainTicks": 300,
    "drainPerTick": 0.3333333,
    "force": 42000.0,
