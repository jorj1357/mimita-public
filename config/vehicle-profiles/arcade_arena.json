  },
  "bindings": {
    "throttle": "walkforward",
    "brake": "walkback",
    "steerLeft": "walkleft",
    "steerRight": "walkright",
    "boost": "mouse_left",
    "jump": "mouse_right",
    "powerslideAirRoll": "key_left_shift",
    "ballCam": "key_space"
