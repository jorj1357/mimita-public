{
  // Neutral four-wheel sedan. Length is X, width is Y, up is Z.
  // All vehicle feel belongs in this file. The load-time
  // vehicle.config.validation event reports static compression and grip.
  "id": "car_sedan",

  // ── Chassis ─────────────────────────────────────────────────────────
  "massKg": 2600,
  "density": 120,
  "centerOfMass": [0.0, 0.0, -0.35],
  "length": 5.0,
  "width": 3.0,
  "height": 1.0,
  "drag": 0.045,
  "downforce": 8.0,
  "bodyFriction": 0.18,
  "bodyWallFriction": 0.05,
  "bodyRestitution": 0.18,
  "reboundScale": 0.55,
  "coastDeceleration": 3.0,
  "coastSpinDamping": 2.5,

  // ── Speed targets / gearing math ────────────────────────────────────
  // 0-60 km/h time: 16.667 m/s / (firstGearForce / massKg)
  // firstGearForce = torqueAt(2000rpm) * gear1 * finalDrive * 0.9 / radius
  // Top speed: redlineRpm*2*pi/60 / (topGear*finalDrive) * radius * 3.6
  // drag is calibrated as forceAtTopSpeed / topSpeed^2.
  "speedTargets": { "zeroTo60KmhSeconds": 1.0, "topSpeedKmh": 999 },
  "linearDamping": 0.04,
  "angularDamping": 1.2,
  "maxAngularSpeed": 8.0,
  "sleepLinearThreshold": 0.12,
  "sleepAngularThreshold": 0.12,
  "sleepRequiredTicks": 80,

  // ── Suspension / stability ──────────────────────────────────────────
  // Per-wheel force cap. Static corner load is massKg * 70 / 4 = 45500 N.
  "maxSuspensionForce": 180000,
  "bumpStopStiffness": 900000,
  "bumpStopDamping": 50000,
  "antiRollForceScale": 6.0,
  "stabilityVerticalDamping": 6.0,
  "stabilityAngularDamping": 6.0,
  "idleSettleSpeed": 2.0,
  "idleSettleHorizontal": 0.90,
  "idleSettleVertical": 0.20,
  "idleSettleAngular": 0.20,

  "interactionRadius": 15.0,
  "bodyTexture": "assets/textureshq/240sx.png",
  "wheelTexture": "assets/textureshq/dark1.png",
  "engineSound": "assets/sound/weapon/chainsaw/chainsawidle.wav",
  "wheelSegments": 32,

  // ── Wheels ──────────────────────────────────────────────────────────
