// Rocket League Octane-class body for the vehicle arena.
//
// Dimensions and mass are Rocket League reference values, not MiMITA guesses:
//   hitbox 118.0 x 84.2 x 36.2 uu  -> 1.18 x 0.842 x 0.362 m
//   car mass 180 kg
//   suspension stiffness 500, compression damping 25, relaxation damping 40,
//   max suspension travel 12 cm (RocketSim RLConst::BTVehicle)
//
// The arcade profile owns acceleration, so the engine/gearbox here only keep
// the shared drivetrain state machine valid.
{
  "id": "octane_rl",
  "massKg": 180,
  "density": 120,
  "centerOfMass": [0.0, 0.0, -0.12],
  "length": 1.18,
  "width": 0.842,
  "height": 0.362,
  "collisionLength": 1.18,
  "collisionWidth": 0.84,
  "collisionHeight": 0.362,
  // Bottom face is the wheel contact plane (hub z -0.10 - wheel radius 0.15
  // = -0.25) and the top is the roof, so the whole car is inside the box and
  // no wheel can sit below the surface.
  "collisionCenter": [0.0, 0.0, -0.0345],
  "drag": 0.0,
  "downforce": 0.0,
  "bodyFriction": 0.30,
  "bodyWallFriction": 0.30,
  "bodyRestitution": 0.30,
  "reboundScale": 1.0,
  "coastDeceleration": 0.0,
  "coastSpinDamping": 0.0,

  "speedTargets": { "zeroTo60KmhSeconds": 0.0, "topSpeedKmh": 82.8 },
  "linearDamping": 0.0,
  "angularDamping": 0.0,
  "maxAngularSpeed": 24.0,
  "sleepLinearThreshold": 0.10,
  "sleepAngularThreshold": 0.10,
  "sleepRequiredTicks": 40,

  "maxSuspensionForce": 6000,
  "bumpStopStiffness": 60000,
  "bumpStopDamping": 3000,
  "antiRollForceScale": 3.0,
  "stabilityVerticalDamping": 2.0,
  "stabilityAngularDamping": 8.0,
  "idleSettleSpeed": 1.0,
  "idleSettleHorizontal": 0.10,
  "idleSettleVertical": 0.05,
  "idleSettleAngular": 0.05,

  "interactionRadius": 8.0,
  "bodyTexture": "assets/textureshq/240sx.png",
  "wheelTexture": "assets/textureshq/dark1.png",
  "engineSound": "assets/sound/weapon/chainsaw/chainsawidle.wav",
  "wheelSegments": 20,

  // Wheel hubs in metres. X forward, Y right, Z up. Ride height matches the
  // 17.0-17.05 uu resting height documented for Octane-class bodies.
  "wheels": [
    {
      "hub": [0.40, 0.36, -0.10],
      "radius": 0.15,
      "collisionRadius": 0.0,
      "width": 0.12,
      "suspensionAxis": [0, 0, -1],
      "spinAxis": [0, 1, 0],
      "steerAxis": [0, 0, 1],
