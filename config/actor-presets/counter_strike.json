{
  "schema": 2,
  "id": "counter_strike",
  "display_name": "Counter-Strike",
  "camera": {
    "fov": 70,
    "force_fov": true,
    "perspective": "first_person",
    "force_perspective": true
  },
  "movement_preset": "heavy",
  "weapon_set": "counterstrike",
  "avatar": {
    "forced": true,
    "name": "jason",
    "allowed": ["jason"]
  },
  "health": {
    "max": 100,
    "spawn": 100
  },
  "team": {
    "allowed": [0, 1]
  },
  "presentation": {
    "damage_numbers": false,
    "hit_effects": false,
    "world_impact_effects": false,
    "blood_effects": true,
    "muzzle_flash": true
  },
  // Generic NPC movement/decision policy (hot-reloadable while the game runs).
  // This owns how the actor moves and makes general movement decisions, never
  // the game objective. Teams/rounds/bomb stay in config/gamemodes/counterstrike.json.
  "npc_behavior": {
    // "forward" = keep moving toward the current desired direction
    // (wander/circle/strafe/hold_position are reserved for future presets)
    "travel_style": "forward",
    // "forward" = keep moving while attacking
    "combat_style": "forward",

    // Explicit permissions. false must prevent the style from being selected
    // by random scoring or legacy state logic.
    "allow_circle": false,
    "allow_random_walk": false,
    "allow_strafe": false,
    "allow_zigzag": false,
    "allow_hold_position": false,

    // "never" | "low_health" (retreat is emergent: more likely as health drops)
    "retreat_style": "low_health",
    // Fraction of maximum health in [0,1]; uses current_health / maximum_health.
    "retreat_health_fraction": 0.35,

    // "never" | "obstacle_only" | "navigation_only" | "obstacle_or_navigation"
    "jump_style": "obstacle_or_navigation",
    // "never" | "attack" | "escape" | "navigation" | "attack_or_navigation"
    "dash_style": "attack_or_navigation",
    // "local_sensing" | "full_map"
    "world_knowledge": "local_sensing",
    // "turn" | "repath" | "turn_then_repath"
    "blocked_behavior": "turn_then_repath",
    // 0.0 = no random directional noise.
    "movement_noise": 0.0
  },
  // Automatic surface navigation from loaded map collision triangles. The
  // shared collision slope rule is used because max_walkable_slope_degrees is
  // omitted, so the planner can never route onto ground the body slides off.
  "navigation": {
    // "automatic_surface_path" is the triangle-based route planner.
    // "direct" is only for simple legacy steering.
    "mode": "automatic_surface_path",

    // Generate navigation from loaded map collision triangles.
    "automatic_from_collision": true,

    // Recalculate when the current route is blocked.
    "repath_when_blocked": true,

    // Maximum local search distance around the NPC.
    "search_radius": 20.0,

    // Allow the planner to create legal navigation jump links.
    "allow_navigation_jumps": true,

    // Never jump directly into a vertical wall.
    "allow_wall_jump": false,

    // "turn" | "repath" | "turn_then_repath"
    "blocked_behavior": "turn_then_repath"
  },
  "weapon_overrides": {
    "revolver": {
      "damage": 35,
      "fire_delay": 0.15,
      "reload_time": 1.5,
      "magazine_size": 6,
      "reserve_ammo": 36,
      "recoil": 30.0,
      "hitscan": {
        "enabled": true,
        "beam_thickness": 0.0,
        "world_thickness": 0.0,
        "range": 1000.0
      }
    },
    "shotgun": {
      "damage": 20,
      "fire_delay": 0.4,
      "reload_time": 2.0,
      "magazine_size": 6,
      "reserve_ammo": 32,
      "hitscan": {
        "enabled": true,
        "beam_thickness": 0.0,
        "world_thickness": 0.0
      }
    },
    "hitscan_rifle": {
      "damage": 30,
      "damage_scale": 1.0,
      "headshot_multiplier": 4.0,
      "fire_delay": 0.1,
      "reload_time": 2.4,
      "magazine_size": 30,
      "reserve_ammo": 180,
      "spread": 0.0,
      "recoil": 0.0,
      "hitscan": {
        "enabled": true,
        "beam_thickness": 0.0,
        "world_thickness": 0.0
      }
    }
  }
}
