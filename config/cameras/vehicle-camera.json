// Rocket League vehicle camera tuning. Presentation only: none of these
// values feed back into car controls.
{
  // Rocket League camera body. Distance/height are metres, angle is degrees
  // (negative looks down), fov is degrees. Presentation only.
  "distanceM": 2.20,
  "heightM": 0.90,
  "pitchDeg": -7.0,
  "fovDeg": 110.0,
  // Rocket League stiffness, 0.0-1.0. 1.0 = glued to the car with no
  // trailing lag and no sway. 0.5 = three car lengths of trailing at top
  // speed. 0.0 = six car lengths (loose).
  // "stiffness": 0.5,
  // "stiffness": 0.0,
  "stiffness": 1.0,
  // Stiffness tuning: six Octane bodies (6 x 1.18 m) of trailing at the
  // profile top speed of 23 m/s. 0.5 therefore trails 3.54 m, 0.0 trails
  // 7.08 m at 23 m/s.
  "stiffnessLagMaxM": 7.08,
  "topSpeedMps": 23.0,
  // Swivel and ball-cam transition speed, 0-10 on the Rocket League scale.
  "transitionSpeed": 10.0,
  "swivelSpeed": 10.0,
  // Ball cam avoidance speed. 0.0 = slowest ease, 1.0 = fastest, 0.5 default.
  "ballCamSnap": 0.5,
  // Ease rate used when ball cam is off (momentum camera), radians/second.
  "momentumRate": 4.0,
  // Ball cam ease rate range mapped from ballCamSnap.
  "ballCamMinRate": 1.2,
  "ballCamMaxRate": 16.0,
  // How fast the right-stick swivel returns to centre, 1/second.
  "swivelReturnRate": 2.5,
  // Swivel travel limits.
  "swivelMaxYawDeg": 110.0,
  "swivelMaxPitchDeg": 55.0,
  // Swivel speed at full right-stick deflection, degrees/second.
  "swivelYawRateDeg": 120.0,
  "swivelPitchRateDeg": 80.0,
  // Instant look-behind offset (R3).
  "lookBehindYawDeg": 180.0
}
