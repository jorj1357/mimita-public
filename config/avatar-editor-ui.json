{
  "format": "mimita-avatar-editor-ui",
  "version": 1,
  "elements": {
    "root_overlay": {
      "type": "container",
      "visible": true,
      "children": [
        {
          "id": "library_panel",
          "type": "panel",
          "x": 20, "y": 50, "width": 280, "height": 900,
          "backgroundColor": [0.05, 0.06, 0.1, 1.0],
          "outlineColor": [0.15, 0.15, 0.2, 1.0],
          "children": [
            {
              "id": "library_title",
              "type": "text_label",
              "x": 32, "y": 58, "width": 260, "height": 24,
              "text": "PNG LIBRARY",
              "fontSize": 0.5,
              "textColor": [0.6, 0.7, 0.8, 1.0]
            },
            {
              "id": "library_import_hint",
              "type": "text_label",
              "x": 32, "y": 82, "width": 260, "height": 18,
              "text": "Drag PNGs from Explorer",
              "fontSize": 0.28,
              "textColor": [0.35, 0.4, 0.5, 1.0]
            }
          ]
        },
        {
          "id": "editor_panel",
          "type": "panel",
          "x": 320, "y": 50, "width": 560, "height": 900,
          "backgroundColor": [0.06, 0.07, 0.11, 1.0],
          "outlineColor": [0.15, 0.15, 0.2, 1.0],
          "children": [
            {
              "id": "editor_title",
              "type": "text_label",
              "x": 332, "y": 58, "width": 260, "height": 24,
              "text": "AVATAR SETTINGS",
              "fontSize": 0.5,
              "textColor": [0.6, 0.7, 0.8, 1.0]
            },
            {
              "id": "tab_faces",
              "type": "text_button",
              "x": 328, "y": 86, "width": 130, "height": 28,
              "text": "Faces",
              "fontSize": 0.32,
              "backgroundColor": [0.1, 0.11, 0.15, 1.0],
              "hoverColor": [0.2, 0.3, 0.4, 1.0],
              "action": {"type": "avatar_editor.select_tab", "params": {"tab": 0}}
            },
            {
              "id": "tab_colors",
              "type": "text_button",
              "x": 462, "y": 86, "width": 130, "height": 28,
              "text": "Colors",
              "fontSize": 0.32,
              "backgroundColor": [0.1, 0.11, 0.15, 1.0],
              "hoverColor": [0.2, 0.3, 0.4, 1.0],
              "action": {"type": "avatar_editor.select_tab", "params": {"tab": 1}}
            },
            {
              "id": "tab_cosmetics",
              "type": "text_button",
              "x": 596, "y": 86, "width": 130, "height": 28,
              "text": "Cosmetics",
              "fontSize": 0.32,
              "backgroundColor": [0.1, 0.11, 0.15, 1.0],
              "hoverColor": [0.2, 0.3, 0.4, 1.0],
              "action": {"type": "avatar_editor.select_tab", "params": {"tab": 2}}
            },
            {
              "id": "tab_presets",
              "type": "text_button",
              "x": 730, "y": 86, "width": 130, "height": 28,
              "text": "Presets",
              "fontSize": 0.32,
              "backgroundColor": [0.1, 0.11, 0.15, 1.0],
              "hoverColor": [0.2, 0.3, 0.4, 1.0],
              "action": {"type": "avatar_editor.select_tab", "params": {"tab": 3}}
            }
          ]
        },
        {
          "id": "outfits_panel",
          "type": "panel",
          "x": 900, "y": 50, "width": 400, "height": 900,
          "backgroundColor": [0.05, 0.06, 0.1, 1.0],
          "outlineColor": [0.15, 0.15, 0.2, 1.0],
          "children": [
            {
              "id": "outfits_title",
              "type": "text_label",
              "x": 912, "y": 58, "width": 260, "height": 24,
              "text": "MY OUTFITS",
              "fontSize": 0.5,
              "textColor": [0.6, 0.7, 0.8, 1.0]
            },
            {
              "id": "outfits_new_btn",
              "type": "text_button",
              "x": 908, "y": 88, "width": 200, "height": 28,
              "text": "+ New Outfit",
              "fontSize": 0.3,
              "backgroundColor": [0.15, 0.3, 0.2, 1.0],
              "action": {"type": "avatar_editor.new_outfit", "params": {}}
            }
          ]
        },
        {
          "id": "bottom_bar",
          "type": "panel",
          "x": 0, "y": 960, "width": 1300, "height": 40,
          "backgroundColor": [0.03, 0.04, 0.08, 0.9],
          "children": [
            {
              "id": "save_status_label",
              "type": "text_label",
              "x": 10, "y": 970, "width": 300, "height": 20,
              "binding": "avatar_editor.save_status",
              "bindingFallback": "Not saved yet",
              "fontSize": 0.24,
              "textColor": [0.4, 0.8, 0.5, 1.0]
            },
            {
              "id": "save_path_label",
              "type": "text_label",
              "x": 10, "y": 984, "width": 500, "height": 14,
              "text": "Saved locally to: ",
              "fontSize": 0.18,
              "textColor": [0.3, 0.3, 0.4, 1.0]
            },
            {
              "id": "save_button",
              "type": "text_button",
              "x": 800, "y": 966, "width": 80, "height": 28,
              "text": "Save",
              "fontSize": 0.28,
              "backgroundColor": [0.2, 0.4, 0.3, 1.0],
              "action": {"type": "avatar_editor.save_now", "params": {}}
            },
            {
              "id": "undo_button",
              "type": "text_button",
              "x": 890, "y": 966, "width": 60, "height": 28,
              "text": "Undo",
              "fontSize": 0.26,
              "backgroundColor": [0.15, 0.15, 0.25, 1.0],
              "action": {"type": "avatar_editor.undo", "params": {}}
            },
            {
              "id": "redo_button",
              "type": "text_button",
              "x": 956, "y": 966, "width": 60, "height": 28,
              "text": "Redo",
              "fontSize": 0.26,
              "backgroundColor": [0.15, 0.15, 0.25, 1.0],
              "action": {"type": "avatar_editor.redo", "params": {}}
            },
            {
              "id": "publish_button",
              "type": "text_button",
              "x": 1030, "y": 966, "width": 100, "height": 28,
              "text": "Publish",
              "fontSize": 0.28,
              "backgroundColor": [0.3, 0.5, 0.4, 1.0],
              "hoverColor": [0.4, 0.6, 0.5, 1.0],
              "action": {"type": "avatar_editor.publish", "params": {}},
              "effects": [{"type": "sway", "amplitude": [2, 1], "speed": 0.6}]
            },
            {
              "id": "back_button",
              "type": "text_button",
              "x": 1140, "y": 966, "width": 80, "height": 28,
              "text": "Back",
              "fontSize": 0.28,
              "backgroundColor": [0.3, 0.15, 0.15, 1.0],
              "action": {"type": "avatar_editor.close", "params": {}}
            }
          ]
        }
      ]
    },

    "dialog.save_popup": {
      "id": "save_popup",
      "type": "modal",
      "x": 400, "y": 300, "width": 400, "height": 200,
      "visible": false,
      "backgroundColor": [0.1, 0.11, 0.15, 1.0],
      "outlineColor": [0.3, 0.3, 0.4, 1.0],
      "children": [
        {
          "id": "save_popup_title",
          "type": "text_label",
          "x": 20, "y": 16, "width": 360, "height": 24,
          "text": "Save Outfit",
          "fontSize": 0.4,
          "textColor": [1, 1, 0.8, 1.0]
        },
        {
          "id": "save_popup_name_label",
          "type": "text_label",
          "x": 20, "y": 56, "width": 120, "height": 20,
          "text": "Outfit Name:",
          "fontSize": 0.28,
          "textColor": [0.6, 0.7, 0.8, 1.0]
        },
        {
          "id": "save_popup_input",
          "type": "text_input",
          "x": 130, "y": 54, "width": 240, "height": 26,
          "backgroundColor": [0.06, 0.07, 0.12, 1.0],
          "textColor": [1, 1, 1, 1.0]
        },
        {
          "id": "save_popup_save_btn",
          "type": "text_button",
          "x": 100, "y": 120, "width": 100, "height": 30,
          "text": "Save",
          "backgroundColor": [0.2, 0.5, 0.3, 1.0],
          "action": {"type": "avatar_editor.confirm_modal", "params": {"modal": "save"}}
        },
        {
          "id": "save_popup_cancel_btn",
          "type": "text_button",
          "x": 220, "y": 120, "width": 100, "height": 30,
          "text": "Cancel",
          "backgroundColor": [0.3, 0.15, 0.15, 1.0],
          "action": {"type": "avatar_editor.cancel_modal", "params": {"modal": "save"}}
        }
      ]
    }
  }
}
