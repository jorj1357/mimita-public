{
    "enabled": true,
    "toggle_key": "G",
    "gravity_scale": 2.0,
    "body_linear_damping": 0.01,
    "body_angular_damping": 2.5,
    "stop_linear_speed": 0.1,
    "stop_angular_speed": 0.4,
    "joint_stiffness": 2000.0,
    "joint_damping": 80.0,
    "world_collision": true,
    "corpse": {
        "lifetime_seconds": 20.0,
        "fade_seconds": 4.0,
        "death_impulse_multiplier": 1.5,
        "spawn_velocity_multiplier": 0.6,
        "blood_interval_seconds": 0.18,
        "blood_enabled": true
    },
    "debug_hitboxes_visible": false,
    "attachments_visible": true,
    "solver_iterations": 24,
    "max_fall_speed": 60.0,
    "restitution": 0.0,
    "friction": 0.5,
    "self_collision": true,
    "joint_position_beta": 1.5,
    "limit_position_beta": 0.25,
    "self_collision_iterations": 2,
    "self_collision_beta": 0.5,
    "self_collision_skin": 0.1,
    "self_collision_max_correction": 0.05,
    "max_angular_speed": 25.0,
    "look_damping": 12.0,
    "body_smoothing": 0.0,
    "torso_look_spring": 8.0,
    "torso_max_angular_step": 90.0,
    "mass": {
        "globalMultiplier": 1.0,
        "head": 2.0,
        "torso": 8.0,
        "leftArm": 1.5,
        "rightArm": 1.5,
        "leftLeg": 2.5,
        "rightLeg": 2.5
    },
    "capsules": {
        "head":     { "radius": 0.30, "half_height": 0.14, "axis": [1, 0, 0], "alpha": 0.1, "center_of_mass": [0, 0, 0] },
        "torso":    { "radius": 0.4, "half_height": 0.44, "axis": [0, 0, 1], "alpha": 0.1, "center_of_mass": [0, 0, 0] },
        "leftArm":  { "radius": 0.208, "half_height": 0.592, "axis": [0, 0, 1], "alpha": 0.1, "center_of_mass": [0, 0, 0] },
        "rightArm": { "radius": 0.208, "half_height": 0.592, "axis": [0, 0, 1], "alpha": 0.1, "center_of_mass": [0, 0, 0] },
        "leftLeg":  { "radius": 0.30, "half_height": 0.50, "axis": [0, 0, 1], "alpha": 0.1, "center_of_mass": [-0.1, 0, 0.1] },
        "rightLeg": { "radius": 0.30, "half_height": 0.50, "axis": [0, 0, 1], "alpha": 0.1, "center_of_mass": [-0.1, 0, 0.1] }
    },
    "attachments": {
        "head":      { "parent": "torso", "offset": [0, 0.0, 1.0], "cone_limit_deg": 999,
                      "rotation_limit_deg": { "x": [-180, 180], "y": [-180, 180], "z": [-180, 180] } },
        "leftArm":  { "parent": "torso", "offset": [0.2, 0.6, 0.4], "cone_limit_deg": 999,
                      "rotation_limit_deg": { "x": [-180, 180], "y": [-180, 180], "z": [-180, 180] } },
        "rightArm": { "parent": "torso", "offset": [0.2, -0.6, 0.4], "cone_limit_deg": 999,
                      "rotation_limit_deg": { "x": [-180, 180], "y": [-180, 180], "z": [-180, 180] } },
        "leftLeg":  { "parent": "torso", "offset": [0.1, 0.3, -0.8], "cone_limit_deg": 50,
                      "rotation_limit_deg": { "x": [-40, 40], "y": [-40, 40], "z": [-40, 40]} },
        "rightLeg": { "parent": "torso", "offset": [0.1, -0.3, -0.8], "cone_limit_deg": 50,
                      "rotation_limit_deg": { "x": [-10, 10], "y": [-40, 40], "z": [-40, 40] } }
    },
    "aim": {
        "head":  { "front_axis": [1, 0, 0], "up_axis": [0, 0, 1] },
        "torso": { "front_axis": [1, 0, 0], "up_axis": [0, 0, 1] }
    },
    "arms": {
        "extend_strength": 500.0,
        "extend_max_speed": 100.0,
        "max_stretch": 0.25,
        "stretch_force": 50.0,
        "body_pull": 0.0
    },
    "grab": {
        "left_key": "A",
        "right_key": "D",
        "extend_left_mouse": 0,
        "extend_right_mouse": 1,
        "extend_force": 1.0,
        "grab_reach": 12.0,
        "grab_radius": 0.01,
        "compliance": 0.02,
        "grace_distance": 2.5
    },
    "head": {
        "rotation_strength": 120.0,
        "rotation_speed": 180.0
    },
    "physical": {
        // "comment":
        //  "Physical aim controller (aimbody.json mode physical, and the ragdoll look motor). 
        // damping_mode: physical = torque/PD, 
        // look = historical velocity blend. 
        // torso_tether_stiffness keeps the dynamic torso on the authoritative movement root.",
        "torque_gain": 20.0,
        "angular_damping": 25.0,
        "max_angular_speed": 30.0,
        "head_weight": 1.0,
        "torso_weight": 1.0,
        "limb_inheritance": 1.0,
        // "limb_inheritance": 0.0,
        // "torso_tether_stiffness": 200.0,
        // "torso_tether_stiffness": 20.0,
        // "torso_tether_stiffness": 1.0,
        "torso_tether_stiffness": 0.01,
        // RMB center-aim physical response. Lower force/damping preserves
        // more movement momentum; max_stretch permits the shoulder link to
        // move from the ordinary side position toward center.
        "right_arm_pointing_position_force": 28.0,
        "right_arm_pointing_position_damping": 2.0,
        "right_arm_pointing_max_stretch": 0.9,
        // "damping_mode": "physical",
        "damping_mode": "look",
        "limits": {
            "comment": "Range of motion in degrees. Torso is clamped relative to the movement root; child limbs are clamped by swing from their bind orientation.",
            "torso_max_pitch_deg": 90.0,
            "torso_max_roll_deg": 90.0,
            "head_max_swing_deg": 45.0,
            "arm_max_swing_deg": 180.0,
            "leg_max_swing_deg": 65.0
        },
        "hybrid": {
            // "comment": "Hybrid mode tracking. 
            // follow_force is the single knob:
            //  1.0 = baseline, 10.0 = limbs track the animations.json / weapon / aimbody pose ten times harder (looks like default mode even at speed). 
            //  base_rate is the internal tracking rate at follow_force 1.0. 
            //  position_follow 0 = orientation only,
            //   1 = limbs also follow their animated position. 
            //   All values are stable at any magnitude.",
            // "follow_force": 10.0,
            "follow_force": 20.0,
            // "follow_force": 50.0,
            // "follow_force": 25.0,
            // "follow_force": 35.0,
            // "follow_force": 15.0,
            // "follow_force": 5.0,
            // "follow_force": 100.0,
            // "follow_force": 1.0,
            // "follow_force": 999.0,
            // "follow_force": 999999.0,
            // "base_rate": 50.0,
            // "base_rate": 100.0,
            "base_rate": 20.0,
            // "base_rate": 999.0,
            // "base_rate": 10.0,
            // "base_rate": 1.0,
            // "base_rate": 3.0,
            // "base_rate": 5.0,
            // "position_follow": 100.0,
            // "position_follow": 0.0,
            // "position_follow": 0.5,
            // "position_follow": 0.01,
            "position_follow": 1.0,
            // Arms-only post-physics sway correction rate (1/s). 0 = fully
            // physical sway; higher values keep the arm closer to its centered
            // aimbody/animation pose relative to the torso.
            // "arms_follow_force": 1.0
            // "arms_follow_force": 5.0
            // "arms_follow_force": 10.0,
            // "arms_follow_force": 25.0
            // "arms_follow_force": 50.0,
            "arms_follow_force": 0.0,
            // 1.0 = current hybrid arm behavior. 10.0 = movement affects the
            // arms 10x less and the arms are 90% closer to their default
            // aimbody/animation pose. Weapon attachment offsets stay weapon-owned.
            "arms_camera_follow": 1.0
            // "arms_camera_follow": 10.0
            // "arms_camera_follow": 100.0
            // "arms_camera_follow": 2.0
            // "arms_camera_follow": 5.0
        }
    },
    "exit": {
        "preserve_velocity": true,
        "hop_velocity": 3.0
    },
    "weapon": {
        "one_handed_enabled": true,
        "hand": "right"
    },
    "camera": {
        "mode": "locked_to_head",
        "smooth_factor": 1.0,
        "third_person_allowed": true
    }
}
