{
    "walkableSlopeDot": 0.80,
    "bodySampleRadius": 0.25,
    "maxStepHeight": 0.25,
    "bodyMeshCollision": true,
    "collisionSkin": 0.0,
    "edgeTouchTolerance": 0.0,
    // "bodyMeshCollision": false,
    // Single authoritative actor-triangle solver for the local player. When true
    // the legacy capsule/body/emergency GLB pipeline is bypassed for players.
    // Local players use this owner. The legacy path remains only as a guarded
    // fallback/NPC path until its TODO-DELETE acceptance gates are complete.
    "actorTriangleSolver": true,
    // Prune actor-triangle vs world-triangle pairs with a per-solve AABB tree
    // instead of scanning the whole candidate list. Semantics are unchanged; it
    // only decides which pairs are worth the narrowphase test.
    "actorCollisionAccelerated": true,
    // Debug only: run the linear scan and the AABB-tree path on the same input
    // and log a structured diff (collision.narrowphase.compare). Leave false in
    // normal play; it roughly doubles actor narrowphase cost while enabled.
    "actorCollisionComparison": false,
    "bounce": {
        "enabled": true,
        "strength": 0.35,
        "friction": 0.0,
        "minSpeed": 0.01,
        "maxSpeed": 999999.0,
        "cooldown": 0.0001,
        "minPush": 0.1
    }
}
