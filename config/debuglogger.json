{
  "version": 2,
  "enabled": true,
  "hot_reload": true,

  "events_file": true,
  "console_mirror": false,
  "flush_each_event": true,
  "repeat_window_seconds": 1.0,

  "default_level": "important",

  "categories": {
    "general": { "level": "off", "file_output": true },
    "glb": { "level": "off", "file_output": true },
    "replay": { "level": "off", "file_output": true },
    "camera": { "level": "off", "file_output": true },
    "audio": { "level": "off", "file_output": true },
    "physics": { "level": "off", "file_output": true },
    "performance": { "level": "off", "file_output": true },
    "collision": { "level": "important", "file_output": true },
    "movement": { "level": "important", "file_output": true },
    "npc_combat": { "level": "important", "file_output": true },
    "npc_movement": { "level": "off", "file_output": true },
    "weapons": { "level": "important", "file_output": true },
    "animation": { "level": "off", "file_output": true },
    "gui": { "level": "off", "file_output": true },
    "avatar": { "level": "off", "file_output": true },
    "network": { "level": "important", "file_output": true, "throttle": 0.0 },
    "world": { "level": "off", "file_output": true },
    "duel": { "level": "off", "file_output": true },
    "auth": { "level": "off", "file_output": true },
    "chat": { "level": "off", "file_output": true },
    "vip": { "level": "off", "file_output": true },
    "rendering": { "level": "off", "file_output": true },
    "glb_models": { "level": "off", "file_output": true },
    "executable": { "level": "errors", "file_output": true },
    "grenade_launcher": { "level": "off", "file_output": true, "throttle": 0.0 },
    "healthbar": { "level": "off", "file_output": true, "throttle": 0.0 },
    "skybox": { "level": "off", "file_output": true, "throttle": 0.0 },
    "chat_layout": { "level": "off", "file_output": true, "throttle": 0.0 },
    "ragdoll": { "level": "off", "file_output": true, "throttle": 0.0 }
  },

  "sampling": {
    "default_every_n_frames": 60,
    "log_on_change": true,
    "minimum_numeric_change": 0.001
  },

  "throttling": {
    "enabled": true,
    "default_max_messages_per_second": 20,
    "duplicate_message_window_ms": 1000
  },

  "replay_validation": {
    "camera_position_tolerance": 0.05,
    "camera_rotation_degrees_tolerance": 0.25,
    "fov_degrees_tolerance": 0.1,
    "quaternion_magnitude_tolerance": 0.0001,
    "audio_video_sync_tolerance_ms": 50.0
  },

  "performance": {
    "target_fps": 60,
    "spike_threshold_ms": 20.0,
    "severe_spike_threshold_ms": 100.0,
    "catastrophic_spike_threshold_ms": 1000.0,
    "capture_call_tree_on_spike": true,
    "top_functions_per_frame": 30,
    "history_frames_before_spike": 120,
    "history_frames_after_spike": 180,
    "aggregate_window_frames": 600,
    "log_allocations": false,
    "log_asset_io": false,
    "log_collision_queries": false,
    "log_entity_counts": false,
    "log_effect_counts": false,
    "log_render_counts": false
  }
}
