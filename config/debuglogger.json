{
  "version": 1,
  "enabled": true,
  "hot_reload": true,
  "console_output": true,
  "summary_file": false,

  "default_level": "off",

  "categories": {
    "general": { "level": "off", "file_output": false },
    "glb": { "level": "off", "file_output": false },
    "replay": {
      "level": "off",
      "file_output": false
    },
    "camera": {
      "level": "off",
      "file_output": false
    },
    "audio": {
      "level": "off",
      "file_output": false
    },
    "physics": { "level": "off", "file_output": false },
    "performance": {
      "level": "off",
      "file_output": false
    },
    "collision": {
      "level": "off",
      "file_output": false
    },
    "npc_combat": { "level": "off", "file_output": false },
    "npc_movement": { "level": "off", "file_output": false },
    "weapons": { "level": "off", "file_output": false },
    "animation": { "level": "off", "file_output": false },
    "gui": {
      "level": "off",
      "file_output": false
    },
    "avatar": {
      "level": "off",
      "file_output": false
    },
    "network": {
      "level": "verbose",
      "file_output": true,
      "throttle": 0.0
    },
    "world": { "level": "off", "file_output": false },
    "duel": { "level": "off", "file_output": false },
    "auth": { "level": "off", "file_output": false },
    "chat": { "level": "off", "file_output": false },
    "vip": { "level": "off", "file_output": false },
    "rendering": {
      "level": "off",
      "file_output": false
    },
    "glb_models": {
      "level": "off",
      "file_output": false
    },
    "executable": {
      "level": "errors",
      "file_output": false
    },
    "grenade_launcher": { "level": "off", "file_output": false, "throttle": 0.0 },
    "healthbar": { "level": "off", "file_output": false, "throttle": 0.0 },
    "skybox": { "level": "off", "file_output": false, "throttle": 0.0 },
    "chat_layout": { "level": "off", "file_output": false, "throttle": 0.0 },
    "ragdoll": { "level": "off", "file_output": false, "throttle": 0.0 }
  },

  "sampling": {
    "default_every_n_frames": 60,
    "log_on_change": true,
    "minimum_numeric_change": 0.001
  },

  "throttling": {
    "enabled": true,
    "default_max_messages_per_second": 20,
    "duplicate_message_window_ms": 1000
  },

  "replay_validation": {
    "camera_position_tolerance": 0.05,
    "camera_rotation_degrees_tolerance": 0.25,
    "fov_degrees_tolerance": 0.1,
    "quaternion_magnitude_tolerance": 0.0001,
    "audio_video_sync_tolerance_ms": 50.0
  },

  "performance": {
    "target_fps": 60,
    "spike_threshold_ms": 20.0,
    "severe_spike_threshold_ms": 100.0,
    "catastrophic_spike_threshold_ms": 1000.0,
    "capture_call_tree_on_spike": true,
    "top_functions_per_frame": 30,
    "history_frames_before_spike": 120,
    "history_frames_after_spike": 180,
    "aggregate_window_frames": 600,
    "log_allocations": false,
    "log_asset_io": false,
    "log_collision_queries": false,
    "log_entity_counts": false,
    "log_effect_counts": false,
    "log_render_counts": false
  }
}

