  "spawnActionDelayTicks": 1,
  // "comment_spawnActionDelayTicks": "Full delay after an NPC spawns or respawns before it may move, acquire a target, or shoot. Fixed 60 Hz server ticks. Set to 1 for about 0.017 seconds; 0 means no extra action delay.",
  "freezeDuringWaveBanner": false,
