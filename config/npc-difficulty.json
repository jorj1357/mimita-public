  // "searchNoProgressSeconds": 1.5,
  // "comment_searchNoProgressSeconds": "If the NPC cannot make progress for this long, it blacklists the spot and picks a new heading (or a short detour while chasing). Stops slope-bottom/corner lock-ups.",

  // ── Live movement/navigation knobs (hot-reloaded; edit while the game runs) ──
  // Floor for the local wall-avoid search probe (m). Too small = every
  // direction looks clear and the actor always turns the same way (circling).
  "wallAvoidMinProbe": 3.0,
  // Strength of the per-actor left/right preference at a wall/corner. Higher
  // spreads a squad across both sides so they do not all jam into one corner;
  // 0 disables the preference (all may pick the same side).
  "turnSideBias": 0.75,
  // "turnSideBias": 10.0,
  // Minimum seconds between recovery hops. Bounds jumping at geometry.
  "jumpCooldownSeconds": 0.45,
  // Low-obstacle hop: jump a blocker at leg height that the torso clears (a
  // crate, a low ledge, a lip that catches the legs). Two forward rays are
  // cast: one at the legs (lowObstacleLowOffset) and one at the torso
  // (lowObstacleHighOffset), relative to the actor's center. A hop happens only
  // when the leg ray is blocked and the torso ray is clear, so a tall wall is
  // still never jumped. All hot-reloadable.
  "lowObstacleJumpEnabled": true,
  // Local-area trap escape. If an actor stays inside areaEscapeRadiusMeters of
  // an anchor for areaEscapeSeconds, it commits to ONE breakout direction for
  // areaEscapeHoldSeconds, ignoring wall-avoid/backtrack flip-flop. This is what
  // stops "walk into wall, step back, walk into the same wall" loops and
  // mid-slope back-and-forth, and maximizes net movement. Hot-reloadable.
  "areaEscapeRadiusMeters": 5.0,
  "areaEscapeSeconds": 4.0,
  "areaEscapeHoldSeconds": 2.0,
  "lowObstacleProbe": 2.0,
  "lowObstacleLowOffset": -1.0,
  "lowObstacleHighOffset": 1.0,
  // Persistent exploration target (no-target Patrol): how far ahead the target
  // is placed, how long it is held before retargeting, and the minimum progress
  // required in that window before retargeting.
  // "exploreDistanceMeters": 60.0,
  // "exploreDistanceMeters": 1.0,
  "exploreDistanceMeters": 100.0,
  "exploreHoldSeconds": 12.0,
  // "exploreHoldSeconds": 0.01,
  // "exploreHoldSeconds": 30.0,
  // "exploreMinProgressMeters": 6.0,
  // "exploreMinProgressMeters": 0.1,
  // "exploreMinProgressMeters": 20.0,
  "exploreMinProgressMeters": 1.0,
  // Long-range navigation graph (lazy chunked walkable graph built from the
  // loaded collision triangles). false = local rolling planner only.
  // This is the one switch that changes the whole movement architecture.
  "useNavGraph": false,
  // "useNavGraph": true,
  // Graph geometry/tuning. chunkSize/cellSize are metres; maxRoutes controls how
  // many distinct equal-cost routes are returned; maxDropHeight bounds drops.
  "navGraphChunkSize": 32.0,
  "navGraphCellSize": 2.0,
  "navGraphMaxRoutes": 3,
  "navGraphMaxDropHeight": 14.0,

