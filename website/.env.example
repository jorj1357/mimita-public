NODE_ENV=development
PORT=3002
APP_ORIGIN=http://localhost:5173

# Stripe powers banner payments and VIP checkout. Use test keys locally.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_VIP_WEBHOOK_SECRET=whsec_replace_me

# Optional VIP cent-price overrides. Defaults are 333/888/1777 monthly and
# 1999/5333/10666 for twelve months.
VIP_PRICE_VIP_ONE_MONTH=333
VIP_PRICE_VIP_MONTHLY=333
VIP_PRICE_VIP_TWELVE_MONTH=1999
VIP_PRICE_SUPER_VIP_ONE_MONTH=888
VIP_PRICE_SUPER_VIP_MONTHLY=888
VIP_PRICE_SUPER_VIP_TWELVE_MONTH=5333
VIP_PRICE_ULTRA_VIP_ONE_MONTH=1777
VIP_PRICE_ULTRA_VIP_MONTHLY=1777
VIP_PRICE_ULTRA_VIP_TWELVE_MONTH=10666

# Use DATABASE_URL or the individual DB_* values.
DATABASE_URL=postgresql://mimita_app:replace_me@127.0.0.1:5432/mimita
DB_SSL=false
DB_USER=mimita_app
DB_HOST=127.0.0.1
DB_NAME=mimita
DB_PASSWORD=replace_me
DB_PORT=5432

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_secret
SESSION_COOKIE_NAME=mimita_session
SESSION_DAYS=30

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=hello@mimita.fun
SMTP_PASS=replace_me
MAIL_FROM="Mimita <hello@mimita.fun>"

# Optional. Used to hash request IPs in analytics audit logs.
ANALYTICS_PRIVACY_SALT=replace_with_a_long_random_secret

# Discord invite URL (overrides hardcoded default in Header)
VITE_DISCORD_URL=https://discord.gg/sY8QHbfG9D
