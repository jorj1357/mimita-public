NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:5173

# Use DATABASE_URL or the individual DB_* values.
DATABASE_URL=postgresql://mimita_app:replace_me@127.0.0.1:5432/mimita
DB_SSL=false
DB_USER=mimita_app
DB_HOST=127.0.0.1
DB_NAME=mimita
DB_PASSWORD=replace_me
DB_PORT=5432

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_secret
SESSION_COOKIE_NAME=mimita_session
SESSION_DAYS=30

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=hello@mimita.fun
SMTP_PASS=replace_me
MAIL_FROM="Mimita <hello@mimita.fun>"

# Optional. Used to hash request IPs in analytics audit logs.
ANALYTICS_PRIVACY_SALT=replace_with_a_long_random_secret
