// mimita.rc — Resource script for mimita.exe
// Embeds the game icon so the running game shows it in the taskbar (GLFW
// windows inherit the exe's icon) plus version metadata. Numeric ID 1 = the
// application icon.
1 ICON "assets/uitextures/mimita desktop icon v1.ico"

// Version metadata — legitimate software carries it; malware does not. The
// resource NAME must be numeric 1 so Windows' version APIs find it.
#define VER_FILEVERSION 2,0,1,0
#define VER_FILEVERSION_STR "2.0.1\0"
#define VER_PRODUCTVERSION 2,0,1,0
#define VER_PRODUCTVERSION_STR "2.0.1\0"
1 VERSIONINFO
 FILEVERSION VER_FILEVERSION
 PRODUCTVERSION VER_PRODUCTVERSION
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "MiMITA\0"
            VALUE "FileDescription", "MiMITA Game\0"
            VALUE "FileVersion", VER_FILEVERSION_STR
            VALUE "InternalName", "mimita\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 MiMITA\0"
            VALUE "OriginalFilename", "mimita.exe\0"
            VALUE "ProductName", "MiMITA\0"
            VALUE "ProductVersion", VER_PRODUCTVERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
