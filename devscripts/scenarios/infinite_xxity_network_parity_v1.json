{
  "schema_version": 1,
  "id": "infinite_xxity_network_parity_v1",
  "description": "Infinite World XXity: move through streamed city chunks and verify the server does not emit position corrections while client and server stream the same deterministic grid chunks.",
  "launch": {
    "profile": "npc-navigation",
    "launch_mode": "58",
    "map": "infinite_xxity",
    "visibility": "visible",
    "reuse_matching_run": false
  },
  "setup": [
    {"id": "teleport_origin", "command": "teleport", "args": ["0,0,3"], "delay_ms_after": 500},
    {"id": "stream_warmup", "wait_seconds": 8}
  ],
  "steps": [
    {"id": "move_east", "command": "agent.move", "args": ["1", "0", "180"], "delay_ms_after": 2500},
    {"id": "move_north", "command": "agent.move", "args": ["0", "1", "180"], "delay_ms_after": 2500},
    {"id": "settle", "wait_seconds": 3}
  ],
  "assertions": [
    {"type": "event_present", "event": "world-stream.identity"},
    {"type": "event_count_at_least", "event": "world-stream.chunk.applied", "minimum": 4},
    {"type": "event_absent", "event": "movement.server-position-corrected"}
  ],
  "timeout_seconds": 180
}
