{
  "schema_version": 1,
  "id": "npc_final_pose_soak_v1",
  "description": "Spawn NPCs on Dust 2, walk the local actor through the reported seam, and require final-pose containment to initialise without resets or collision speed collapse.",
  "launch": {
    "profile": "npc-navigation",
    "launch_mode": "1",
    "map": "dust2cyberiav4",
    "weapon_set": "12",
    "visibility": "headless",
    "reuse_matching_run": false
  },
  "setup": [],
  "steps": [
    {"id": "spawn_npcs", "command": "npc_spawn", "args": ["4"], "delay_ms_after": 3000},
    {"id": "walk_seam", "command": "agent.move", "args": ["1", "0", "420"], "delay_ms_after": 10000}
  ],
  "assertions": [
    {"type": "event_present", "event": "npc.pose.last_clear"},
    {"type": "event_absent", "event": "npc.pose.reset"},
    {"type": "event_absent", "event": "collision.speed_collapse"},
    {"type": "event_absent", "event": "collision.progress.stall"}
  ],
  "timeout_seconds": 180
}
