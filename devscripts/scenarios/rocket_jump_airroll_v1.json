{
  "schema_version": 1,
  "id": "rocket_jump_airroll_v1",
  "description": "Prove air control end to end: jump, then hold roll while airborne and assert the server applies air-control torque, the car tilts past upright, and angular speed stays inside the 5.5 rad/s Rocket League cap.",
  "launch": {
    "launch_mode": 60,
    "visibility": "visible",
    "reuse_matching_run": false
  },
  "setup": [
    {"id": "profile", "wait_for_event": "vehicle.profile.applied", "timeout_seconds": 60},
    {"id": "seated", "wait_for_event": "vehicle.entered", "timeout_seconds": 60},
    {"id": "settle", "wait_seconds": 2}
  ],
  "steps": [
    {"id": "clear", "command": "vehicle_input", "args": ["local", "0", "0", "0", "1", "0"], "delay_ms_after": 300},
    {"id": "jump", "command": "vehicle_input", "args": ["local", "0", "0", "0", "1", "0", "0", "0", "0", "1"], "delay_ms_after": 250},
    {"id": "release_jump", "command": "vehicle_input", "args": ["local", "0", "0", "0", "1", "0", "0", "0", "0", "0"], "delay_ms_after": 150},
    {"id": "roll_right", "command": "vehicle_input", "args": ["local", "0", "0", "0", "1", "0", "0", "0", "0.9"], "delay_ms_after": 550},
    {"id": "pitch_back", "command": "vehicle_input", "args": ["local", "0", "0", "0", "1", "0", "-0.9", "0", "0.9"], "delay_ms_after": 450},
    {"id": "stop", "command": "vehicle_input", "args": ["local", "0", "0", "0", "1", "0"], "delay_ms_after": 400}
  ],
  "assertions": [
    {"type": "event_present", "event": "vehicle.jump"},
    {"type": "event_present", "event": "vehicle.airroll"},
    {"type": "event_field_equals", "event": "vehicle.state", "field": "air_control", "equals": true},
    {"type": "event_field_equals", "event": "vehicle.state", "field": "airborne", "equals": true},
    {"type": "event_field_at_least", "event": "vehicle.state", "field": "roll_input", "value": 0.5},
    {"type": "event_field_at_least", "event": "vehicle.state", "field": "angular_speed", "value": 0.5},
    {"type": "event_field_at_most", "event": "vehicle.state", "field": "angular_speed", "value": 5.5},
    {"type": "event_field_at_most", "event": "vehicle.state", "field": "up_dot_world_up", "value": 0.97}
  ],
  "timeout_seconds": 180
}
