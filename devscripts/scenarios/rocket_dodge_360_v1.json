{
  "schema_version": 1,
  "id": "rocket_dodge_360_v1",
  "description": "A dodge must rotate the car a full 360 degrees in the dodge direction. Jump, then dodge sideways, and assert the finished dodge reports its accumulated rotation.",
  "launch": {
    "launch_mode": 60,
    "visibility": "visible",
    "reuse_matching_run": false
  },
  "setup": [
    {"id": "profile", "wait_for_event": "vehicle.profile.applied", "timeout_seconds": 60},
    {"id": "seated", "wait_for_event": "vehicle.entered", "timeout_seconds": 60},
    {"id": "settle", "wait_seconds": 2}
  ],
  "steps": [
    {"id": "clear", "command": "vehicle_input", "args": ["local", "0", "0", "0", "1", "0"], "delay_ms_after": 200},
    {"id": "jump", "command": "vehicle_input", "args": ["local", "0", "0", "0", "1", "0", "0", "0", "0", "1"], "delay_ms_after": 250},
    {"id": "release", "command": "vehicle_input", "args": ["local", "0", "0", "0", "1", "0"], "delay_ms_after": 150},
    {"id": "dodge_right", "command": "vehicle_input", "args": ["local", "0", "0", "0", "1", "0", "0", "0.9", "0", "1"], "delay_ms_after": 400},
    {"id": "release_dodge", "command": "vehicle_input", "args": ["local", "0", "0", "0", "1", "0"], "delay_ms_after": 1500},
    {"id": "finished", "wait_for_event": "vehicle.flip", "timeout_seconds": 20}
  ],
  "assertions": [
    {"type": "event_present", "event": "vehicle.dodge"},
    {"type": "event_field_at_least", "event": "vehicle.flip", "field": "rotation_deg_total", "value": 300.0},
    {"type": "event_field_at_most", "event": "vehicle.flip", "field": "rotation_deg_total", "value": 400.0}
  ],
  "timeout_seconds": 180
}
