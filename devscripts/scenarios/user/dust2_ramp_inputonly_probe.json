{
  "schema_version": 1,
  "id": "dust2_ramp_inputonly_probe",
  "description": "Replay the human-recorded Dust2 ramp inputs as schema-1 input-only because the original schema-2 capture lacks server_actors.",
  "launch": {
    "profile": "npc-navigation",
    "launch_mode": "1",
    "map": "dust2cyberiav4",
    "weapon_set": "29",
    "visibility": "headless",
    "reuse_matching_run": false
  },
  "setup": [],
  "steps": [
    {
      "id": "play_dust2_ramp_input_only",
      "type": "input_playback",
      "path": "devscripts/scenarios/user/scenario-20261031_034240-dustcoll-input-only.jsonl",
      "timeout_seconds": 180
    }
  ],
  "assertions": [
    {
      "type": "event_present",
      "event": "scenario.playback.started"
    },
    {
      "type": "event_present",
      "event": "scenario.playback.start_ready"
    },
    {
      "type": "event_present",
      "event": "scenario.playback.completed"
    },
    {
      "type": "event_absent",
      "event": "scenario.playback.failed"
    },
    {
      "type": "event_count_at_least",
      "event": "collision.capsule-world.solve",
      "minimum": 1
    },
    {
      "type": "event_count_at_least",
      "event": "collision.arcade_capsule.final",
      "minimum": 1
    },
    {
      "type": "event_absent",
      "event": "collision.progress.stall"
    }
  ],
  "timeout_seconds": 240
}
