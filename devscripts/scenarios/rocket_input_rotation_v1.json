{
  "schema_version": 1,
  "id": "rocket_input_rotation_v1",
  "description": "Prove rotational intent crosses the wire: a seated driver's pitch/yaw/roll reach the authoritative server, which is the only way a networked car can air roll, dodge, or stall.",
  "launch": {
    "launch_mode": 60,
    "visibility": "visible",
    "reuse_matching_run": false
  },
  "setup": [
    {"id": "profile", "wait_for_event": "vehicle.profile.applied", "timeout_seconds": 60},
    {"id": "seated", "wait_for_event": "vehicle.entered", "timeout_seconds": 60},
    {"id": "settle", "wait_seconds": 2}
  ],
  "steps": [
    {"id": "drive", "command": "vehicle_input", "args": ["local", "1", "0", "0", "1", "0"], "delay_ms_after": 800},
    {"id": "pitch_back", "command": "vehicle_input", "args": ["local", "1", "0", "0", "1", "0", "0.9", "0", "0"], "delay_ms_after": 500},
    {"id": "yaw_right", "command": "vehicle_input", "args": ["local", "1", "0", "0", "1", "0", "0", "0.8", "0"], "delay_ms_after": 500},
    {"id": "roll_right", "command": "vehicle_input", "args": ["local", "1", "0", "0", "1", "0", "0", "0", "0.9"], "delay_ms_after": 500},
    {"id": "stop", "command": "vehicle_input", "args": ["local", "0", "0", "0", "1", "0"], "delay_ms_after": 400}
  ],
  "assertions": [
    {"type": "event_present", "event": "vehicle.profile.applied"},
    {"type": "event_present", "event": "vehicle.input.local"},
    {"type": "event_present", "event": "vehicle.input.server"},
    {"type": "event_field_at_least", "event": "vehicle.input.local", "field": "pitch", "value": 0.5},
    {"type": "event_field_at_least", "event": "vehicle.input.local", "field": "yaw", "value": 0.5},
    {"type": "event_field_at_least", "event": "vehicle.input.local", "field": "roll", "value": 0.5},
    {"type": "event_field_at_least", "event": "vehicle.input.server", "field": "pitch", "value": 0.5},
    {"type": "event_field_at_least", "event": "vehicle.input.server", "field": "yaw", "value": 0.5},
    {"type": "event_field_at_least", "event": "vehicle.input.server", "field": "roll", "value": 0.5}
  ],
  "timeout_seconds": 180
}
