{
  "schema_version": 1,
  "id": "priority2_equip_respawn_v1",
  "description": "Priority 2: stable equipped identity authorizes attacks before and after respawn without a manual re-equip; no false weapon_not_equipped.",
  "launch": {
    "profile": "npc-navigation",
    "launch_mode": "1",
    "map": "mimita-aabb-only-interior-small-v4",
    "visibility": "visible",
    "reuse_matching_run": true
  },
  "setup": [],
  "steps": [
    {"id": "equip_rocket_before", "command": "equipweapon", "args": ["rocket_launcher"], "delay_ms_after": 1000},
    {"id": "shoot_before", "command": "agent.shoot", "args": [], "delay_ms_after": 1500},
    {"id": "respawn", "command": "respawn_all", "args": [], "delay_ms_after": 1500},
    {"id": "shoot_after", "command": "agent.shoot", "args": [], "delay_ms_after": 1500},
    {"id": "snapshot_end", "command": "agent.snapshot", "args": ["p2_end"]}
  ],
  "assertions": [
    {"type": "event_present", "event": "weapon.attack.result"},
    {"type": "event_field_equals", "event": "weapon.attack.result", "field": "accepted", "equals": 1},
    {"type": "event_absent", "event": "weapon.attack.weapon_not_equipped"},
    {"type": "event_present", "event": "weapon.spawn.equipped_applied"}
  ],
  "timeout_seconds": 180
}
