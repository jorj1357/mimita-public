{
  "schema_version": 1,
  "id": "arm_ragdoll_probe_v1",
  "description": "Equip the mace, select its secondary physical-arm action through the shared input boundary, and verify the arm motor responds to movement.",
  "launch": {
    "profile": "npc-navigation",
    "launch_mode": "1",
    "map": "cramped",
    "weapon_set": "29",
    "visibility": "visible",
    "reuse_matching_run": false
  },
  "setup": [
    {"id": "tank", "command": "healthme", "args": ["999999"], "delay_ms_after": 1000}
  ],
  "steps": [
    {"id": "equip_mace", "command": "equipweapon", "args": ["mace"], "delay_ms_after": 1000},
    {"id": "move_into_slam", "command": "agent.move", "args": ["1", "0", "60"], "delay_ms_after": 100},
    {"id": "press_secondary", "command": "agent.weaponbutton", "args": ["secondary", "1"], "delay_ms_after": 100},
    {"id": "release_secondary", "command": "agent.weaponbutton", "args": ["secondary", "0"], "delay_ms_after": 100},
    {"id": "arm_end", "command": "agent.snapshot", "args": ["arm_ragdoll_end"], "delay_ms_after": 1200},
    {"id": "snapshot_after_hold", "command": "agent.snapshot", "args": ["arm_ragdoll_after_hold"], "delay_ms_after": 500}
  ],
  "assertions": [
    {"type": "event_present", "event": "armragdoll.activate"},
    {"type": "event_present", "event": "armragdoll.motor"}
  ],
  "timeout_seconds": 120
}
