{
  "schema_version": 1,
  "id": "infinite_streaming_240_churn_v1",
  "description": "Single-client Infinite World max-churn acceptance: 30 s of repeated far teleports forcing streamed chunk unload/reload, requiring >=99.99% of frames at 240 FPS and min FPS >=235.",
  "launch": {
    "profile": "npc-navigation",
    "launch_mode": "52",
    "map": "infinite_mixed",
    "visibility": "visible",
    "reuse_matching_run": false
  },
  "setup": [
    {"id": "target_240", "command": "perf_target", "args": ["240"], "delay_ms_after": 200},
    {"id": "frame_cap", "command": "maxframes", "args": ["999"], "delay_ms_after": 200},
    {"id": "perf_overlay_off", "command": "perf", "args": ["0"], "delay_ms_after": 100},
    {"id": "perf_spikes_off", "command": "perf_spikes", "args": ["0"], "delay_ms_after": 100},
    {"id": "perf_file_off", "command": "perf_file_logging", "args": ["0"], "delay_ms_after": 100},
    {"id": "equip_nothing", "command": "equipweapon", "args": ["nothing"], "delay_ms_after": 200},
    {"id": "spawn_origin", "command": "teleport", "args": ["0,0,3"], "delay_ms_after": 500},
    {"id": "stream_warmup", "wait_seconds": 10}
  ],
  "steps": [
    {"id": "churn_benchmark", "command": "perf_benchmark", "args": ["30", "churn"], "delay_ms_after": 100},
    {"id": "tp_01", "command": "teleport", "args": ["400,0,3"], "delay_ms_after": 1100},
    {"id": "tp_02", "command": "teleport", "args": ["800,0,3"], "delay_ms_after": 1100},
    {"id": "tp_03", "command": "teleport", "args": ["1200,0,3"], "delay_ms_after": 1100},
    {"id": "tp_04", "command": "teleport", "args": ["1600,0,3"], "delay_ms_after": 1100},
    {"id": "tp_05", "command": "teleport", "args": ["2000,0,3"], "delay_ms_after": 1100},
    {"id": "tp_06", "command": "teleport", "args": ["2400,0,3"], "delay_ms_after": 1100},
    {"id": "tp_07", "command": "teleport", "args": ["2800,0,3"], "delay_ms_after": 1100},
    {"id": "tp_08", "command": "teleport", "args": ["3200,0,3"], "delay_ms_after": 1100},
    {"id": "tp_09", "command": "teleport", "args": ["3600,0,3"], "delay_ms_after": 1100},
    {"id": "tp_10", "command": "teleport", "args": ["4000,0,3"], "delay_ms_after": 1100},
    {"id": "tp_11", "command": "teleport", "args": ["0,400,3"], "delay_ms_after": 1100},
    {"id": "tp_12", "command": "teleport", "args": ["0,800,3"], "delay_ms_after": 1100},
    {"id": "tp_13", "command": "teleport", "args": ["0,1200,3"], "delay_ms_after": 1100},
    {"id": "tp_14", "command": "teleport", "args": ["0,1600,3"], "delay_ms_after": 1100},
    {"id": "tp_15", "command": "teleport", "args": ["0,2000,3"], "delay_ms_after": 1100},
    {"id": "tp_16", "command": "teleport", "args": ["0,2400,3"], "delay_ms_after": 1100},
    {"id": "tp_17", "command": "teleport", "args": ["0,2800,3"], "delay_ms_after": 1100},
    {"id": "tp_18", "command": "teleport", "args": ["0,3200,3"], "delay_ms_after": 1100},
    {"id": "tp_19", "command": "teleport", "args": ["0,3600,3"], "delay_ms_after": 1100},
    {"id": "tp_20", "command": "teleport", "args": ["0,4000,3"], "delay_ms_after": 1100},
    {"id": "tp_21", "command": "teleport", "args": ["-400,-400,3"], "delay_ms_after": 1100},
    {"id": "tp_22", "command": "teleport", "args": ["-800,-800,3"], "delay_ms_after": 1100},
    {"id": "tp_23", "command": "teleport", "args": ["-1200,-1200,3"], "delay_ms_after": 1100},
    {"id": "tp_24", "command": "teleport", "args": ["-1600,-1600,3"], "delay_ms_after": 1100},
    {"id": "tp_25", "command": "teleport", "args": ["-2000,-2000,3"], "delay_ms_after": 1100},
    {"id": "tp_26", "command": "teleport", "args": ["-2400,-2400,3"], "delay_ms_after": 1100},
    {"id": "tp_27", "command": "teleport", "args": ["-2800,-2800,3"], "delay_ms_after": 1100},
    {"id": "tp_28", "command": "teleport", "args": ["-3200,-3200,3"], "delay_ms_after": 1100},
    {"id": "tp_29", "command": "teleport", "args": ["-3600,-3600,3"], "delay_ms_after": 1100},
    {"id": "tp_30", "command": "teleport", "args": ["-4000,-4000,3"], "delay_ms_after": 1100},
    {"id": "wait_churn", "wait_for_event": "performance.benchmark.summary", "where": {"label": "churn"}, "timeout_seconds": 60}
  ],
  "assertions": [
    {"type": "event_field_equals", "event": "performance.benchmark.summary", "where": {"label": "churn"}, "field": "target_fps", "equals": 240},
    {"type": "event_field_equals", "event": "performance.benchmark.summary", "where": {"label": "churn"}, "field": "frame_cap", "equals": 999},
    {"type": "event_field_at_most", "event": "performance.benchmark.summary", "where": {"label": "churn"}, "field": "frames_over_240_budget", "value": 0},
    {"type": "event_field_at_least", "event": "performance.benchmark.summary", "where": {"label": "churn"}, "field": "percent_at_or_above_240", "value": 99.99},
    {"type": "event_field_at_least", "event": "performance.benchmark.summary", "where": {"label": "churn"}, "field": "min_fps", "value": 235},
    {"type": "event_field_at_least", "event": "performance.benchmark.summary", "where": {"label": "churn"}, "field": "chunks_added", "value": 3000},
    {"type": "event_field_at_least", "event": "performance.benchmark.summary", "where": {"label": "churn"}, "field": "chunks_removed", "value": 3000},
    {"type": "event_field_equals", "event": "performance.benchmark.summary", "where": {"label": "churn"}, "field": "loaded_collision_match_all", "equals": true},
    {"type": "event_field_at_most", "event": "performance.benchmark.summary", "where": {"label": "churn"}, "field": "collision_rebuild_max_ms", "value": 4.167}
  ],
  "timeout_seconds": 180
}
